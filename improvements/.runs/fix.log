    55	/** One standing bilingual feed card with a shader wipe between its two canvas faces. */
    56	export class FeedCard {
    57	  readonly object = new Group();
    58	
    59	  private readonly slopTexture: CanvasTexture;
    60	  private readonly originalTexture: CanvasTexture;
    61	  private readonly wipeUniform: WipeUniform = { value: 0 };
    62	  private readonly reducedMotion: () => boolean;
    63	  private target = 0;
    64	  private delay = 0;
    65	  private disposed = false;
    66	
    67	  constructor(data: FeedCardData, options: FeedCardOptions = {}) {
    68	    this.reducedMotion = options.reducedMotion ?? (() => false);
    69	    this.object.name = 'feed-card';
    70	
    71	    const frame = new Mesh(
    72	      new RoundedBoxGeometry(FRAME_WIDTH, FRAME_HEIGHT, FRAME_DEPTH, 3, FRAME_RADIUS),
    73	      new MeshStandardMaterial({ color: PALETTE.wood, roughness: 0.82, metalness: 0.04 }),
    74	    );
    75	    frame.name = 'feed-card-frame';
    76	    frame.position.y = FACE_Y;
    77	    this.object.add(frame);
    78	
    79	    const postGeometry = new CylinderGeometry(0.07, 0.09, POST_HEIGHT, 12);
    80	    const postMaterial = new MeshStandardMaterial({
    81	      color: PALETTE.wood,
    82	      roughness: 0.86,
    83	      metalness: 0.02,
    84	    });
    85	    [-POST_X, POST_X].forEach((x, index) => {
    86	      const post = new Mesh(postGeometry, postMaterial);
    87	      post.name = `feed-card-post-${index}`;
    88	      post.position.set(x, POST_Y, POST_Z);
    89	      this.object.add(post);
    90	    });
    91	
    92	    this.slopTexture = createCardTexture(data, false);
    93	    this.originalTexture = createCardTexture(data, true);
    94	    const faceMaterial = this.createFaceMaterial();
    95	    faceMaterial.userData['originalMap'] = this.originalTexture;
    96	    faceMaterial.userData['slopMap'] = this.slopTexture;
    97	    faceMaterial.userData['uWipe'] = this.wipeUniform;
    98	
    99	    const face = new Mesh(new PlaneGeometry(FACE_WIDTH, FACE_HEIGHT), faceMaterial);
   100	    face.name = 'feed-card-face';
   101	    face.position.set(0, FACE_Y, FACE_Z);
   102	    this.object.add(face);
   103	  }
   104	
   105	  get original(): boolean {
   106	    return this.wipeUniform.value > 0.5;
   107	  }
   108	
   109	  get wipe(): number {
   110	    return this.wipeUniform.value;
   111	  }
   112	
   113	  setOriginal(on: boolean, delaySeconds = 0): void {
   114	    this.target = on ? 1 : 0;
   115	    this.delay = Math.max(0, delaySeconds);
   116	    if (this.reducedMotion()) {
   117	      this.delay = 0;
   118	      this.setWipe(this.target);
   119	    }
   120	  }
   121	
   122	  update(dt: number): void {
   123	    if (this.reducedMotion()) {
   124	      this.delay = 0;
   125	      this.setWipe(this.target);
   126	      return;
   127	    }
   128	
   129	    let remaining = Math.max(0, dt);
   130	    if (this.delay > 0) {
   131	      if (remaining <= this.delay) {
   132	        this.delay -= remaining;
   133	        return;
   134	      }
   135	      remaining -= this.delay;
   136	      this.delay = 0;
   137	    }
   138	
   139	    if (remaining === 0 || this.wipeUniform.value === this.target) {
   140	      return;
   141	    }
   142	    const distance = Math.min(
   143	      remaining * WIPE_RATE,
   144	      Math.abs(this.target - this.wipeUniform.value),
   145	    );
   146	    this.setWipe(
   147	      this.wipeUniform.value + Math.sign(this.target - this.wipeUniform.value) * distance,
   148	    );
   149	  }
   150	
   151	  dispose(): void {
   152	    if (this.disposed) {
   153	      return;
   154	    }
   155	    this.disposed = true;
   156	    // `disposeObject3D` sees the original map through MeshBasicMaterial.map. The translated map is
   157	    // deliberately stored in userData for the shader, so release it explicitly here.
   158	    this.slopTexture.dispose();
   159	    disposeObject3D(this.object);
   160	    this.object.clear();
   161	  }
   162	
   163	  private setWipe(value: number): void {
   164	    this.wipeUniform.value = Math.min(1, Math.max(0, value));
   165	  }
   166	
   167	  private createFaceMaterial(): MeshBasicMaterial {
   168	    const material = new MeshBasicMaterial({
   169	      map: this.originalTexture,
   170	      fog: true,
   171	      toneMapped: true,
   172	    });
   173	    material.onBeforeCompile = (shader) => {
   174	      shader.uniforms['uWipe'] = this.wipeUniform;
   175	      shader.uniforms['uOriginalMap'] = { value: this.originalTexture };
   176	      shader.uniforms['uSlopMap'] = { value: this.slopTexture };
   177	
   178	      const declarations = [
   179	        'uniform float uWipe;',
   180	        'uniform sampler2D uOriginalMap;',
   181	        'uniform sampler2D uSlopMap;',
   182	      ].join('\n');
   183	      if (shader.fragmentShader.includes('#include <common>')) {
   184	        shader.fragmentShader = shader.fragmentShader.replace(
   185	          '#include <common>',
   186	          `#include <common>\n${declarations}`,
   187	        );
   188	      } else {
   189	        shader.fragmentShader = shader.fragmentShader.replace(
   190	          'void main() {',
   191	          `${declarations}\nvoid main() {`,
   192	        );
   193	      }
   194	
   195	      shader.fragmentShader = shader.fragmentShader.replace(
   196	        '#include <map_fragment>',
   197	        `
   198	          float e = uWipe * 1.08 - .04;
   199	          vec4 originalColor = texture2D(uOriginalMap, vMapUv);
   200	          vec4 slopColor = texture2D(uSlopMap, vMapUv);
   201	          float showOriginal = step(vMapUv.x, e);
   202	          diffuseColor = mix(slopColor, originalColor, showOriginal);
   203	          // The amber seam exists only while the wipe runs, not as a glowing edge at rest.
   204	          float seam = exp(-abs(vMapUv.x - e) * 70.0) * smoothstep(0.0, 0.04, uWipe) * smoothstep(1.0, 0.96, uWipe);
   205	          diffuseColor.rgb += seam * vec3(1.0, 0.6, 0.22) * 4.0;
   206	        `,
   207	      );
   208	    };
   209	    return material;
   210	  }
   211	}
