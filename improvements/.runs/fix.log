    21	/** Metres from the walk's centre line to either toy: past the ridge and release cairns on one side. */
    22	export const TOY_SIDE_OFFSET = 4.5;
    23	/**
    24	 * Where each toy may stand, in order of preference: a share of the walk and a side of it (+1 the
    25	 * language pillars' side, −1 the commit ridge's). The terminal stands early and the lever late, both
    26	 * short of or past the pillar row at the midpoint. The first spot whose footprint keeps `TOY_ROOM`
    27	 * from everything the environment blocks wins: the Plaza's fountain, for one, fills the pillar
    28	 * side of the early walk, so its terminal crosses to the other side.
    29	 */
    30	export const TERMINAL_SPOTS: readonly (readonly [along: number, side: 1 | -1])[] = [
    31	  [0.3, 1],
    32	  [0.25, 1],
    33	  [0.35, 1],
    34	  [0.3, -1],
    35	  [0.25, -1],
    36	  [0.35, -1],
    37	];
    38	export const LEVER_SPOTS: readonly (readonly [along: number, side: 1 | -1])[] = [
    39	  [0.7, -1],
    40	  [0.75, -1],
    41	  [0.65, -1],
    42	  [0.7, 1],
    43	  [0.75, 1],
    44	];
    45	/** Radius around a toy's centre that holds its whole footprint: half the terminal's width. */
    46	const TOY_REACH = 1.35;
    47	const TOY_ROOM = 1;
    48	
    49	export interface ToyPlacement {
    50	  readonly position: Vector3;
    51	  /** Exhibit convention: 0 faces +Z. */
    52	  readonly rotationY: number;
    53	}
    54	
    55	/** What the exhibit poster adds to the project's own copy, for a world that has more to say. */
    56	export type PosterCopy = Pick<ScreenLandmarkOptions, 'kicker' | 'englishSummary' | 'comparison'>;
