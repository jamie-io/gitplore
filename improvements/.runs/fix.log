    86	  const contentWidth = POSTER_WIDTH - PADDING_X * 2;
    87	  const leftWidth = (contentWidth - COLUMN_GAP) * (1.25 / 2.25);
    88	  const rightX = PADDING_X + leftWidth + COLUMN_GAP;
