   357	      .scale(1.6, 0.12, 0.7)
   358	      .translate(0.8, 0, 0)
   359	      .rotateZ(0.35)
   360	      .rotateY(yaw)
   361	      .translate(0, stalk, 0);
   362	    parts.push(paint(leaf, i % 2 ? 0x2f7a3a : 0x3c8c44));
   363	  }
   364	  return assemble(parts);
   365	}
   366	
   367	/** A low fern for the forest floor. */
   368	export function groundFern(seed: number): BufferGeometry {
