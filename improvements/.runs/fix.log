    16	/**
    17	 * Moves every vertex by up to `amount` metres on each axis. Vertices that coincide move together
    18	 * (keyed by position), so faces of Three's primitives — which duplicate corners — stay closed.
    19	 */
    20	export function jitter(geometry: BufferGeometry, amount: number, random: Random): BufferGeometry {
    21	  const position = geometry.getAttribute('position');
    22	  const offsets = new Map<string, readonly [number, number, number]>();
    23	
    24	  for (let i = 0; i < position.count; i++) {
    25	    const key = `${Math.round(position.getX(i) * 1000)},${Math.round(position.getY(i) * 1000)},${Math.round(position.getZ(i) * 1000)}`;
    26	    let offset = offsets.get(key);
    27	    if (!offset) {
    28	      offset = [
    29	        between(random, -amount, amount),
    30	        between(random, -amount, amount),
    31	        between(random, -amount, amount),
    32	      ];
    33	      offsets.set(key, offset);
    34	    }
    35	    position.setXYZ(
    36	      i,
    37	      position.getX(i) + offset[0],
    38	      position.getY(i) + offset[1],
    39	      position.getZ(i) + offset[2],
    40	    );
    41	  }
    42	
    43	  position.needsUpdate = true;
    44	  return geometry;
    45	}
