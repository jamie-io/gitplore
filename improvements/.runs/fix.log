   267	/** Ported from the lookdev's `cardTexture`: the parts people recognise from a video feed. */
   268	function drawCard(context: CanvasRenderingContext2D, data: FeedCardData, original: boolean): void {
   269	  const accent = original ? PALETTE.original : PALETTE.slop;
   270	  context.setTransform(1, 0, 0, 1, 0, 0);
   271	  context.textAlign = 'left';
   272	  context.textBaseline = 'top';
   273	  context.fillStyle = accent;
   274	  context.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
   275	  fillRoundedRect(context, 8, 8, 624, 584, 18, INNER);
   276	
   277	  // The thumbnail: the creator's own artwork, with the translated title burned over it when slop.
   278	  context.save();
   279	  roundedPath(
   280	    context,
   281	    THUMBNAIL.x,
   282	    THUMBNAIL.y,
   283	    THUMBNAIL.width,
   284	    THUMBNAIL.height,
   285	    THUMBNAIL.radius,
   286	  );
   287	  context.clip();
   288	  context.fillStyle = data.bg;
   289	  context.fillRect(THUMBNAIL.x, THUMBNAIL.y, THUMBNAIL.width, THUMBNAIL.height);
   290	  context.fillStyle = data.wordColor;
   291	  context.font = `800 ${data.word.length > 8 ? 86 : 140}px ${FONT_BARLOW}`;
   292	  context.fillText(data.word, 48, 40);
   293	  if (data.sub) {
   294	    context.fillStyle = PALETTE.ink;
   295	    context.font = `500 30px ${FONT_MONO}`;
   296	    context.fillText(data.sub, 54, 196);
   297	  }
   298	  if (!original) {
   299	    context.save();
   300	    context.translate(40, 110);
   301	    context.rotate(-0.05);
   302	    context.font = 'bold 50px Arial, sans-serif';
   303	    const width = context.measureText(data.slopThumb).width + 36;
   304	    context.fillStyle = 'rgba(0, 0, 0, 0.3)';
   305	    context.fillRect(0, 6, width, 70);
   306	    context.fillStyle = '#ffffff';
   307	    context.fillRect(0, 0, width, 70);
   308	    context.fillStyle = '#111111';
   309	    context.fillText(data.slopThumb, 18, 10);
   310	    context.restore();
   311	    fillRoundedRect(context, 38, 38, 170, 40, 6, PALETTE.slop);
   312	    context.fillStyle = '#ffffff';
   313	    context.font = '700 24px system-ui, sans-serif';
   314	    context.fillText('KI-übersetzt', 52, 46);
   315	  }
   316	  fillRoundedRect(context, 520, 310, 84, 36, 6, 'rgba(0, 0, 0, 0.82)');
   317	  context.fillStyle = '#ffffff';
   318	  context.font = `500 24px ${FONT_MONO}`;
   319	  context.fillText(data.duration, 532, 316);
   320	  context.restore();
   321	
   322	  context.fillStyle = data.avatarBg;
   323	  context.beginPath();
   324	  context.arc(62, 412, 30, 0, Math.PI * 2);
   325	  context.fill();
   326	  context.fillStyle = '#ffffff';
   327	  context.font = `700 30px ${FONT_BARLOW}`;
   328	  context.textAlign = 'center';
   329	  context.fillText(data.avatar, 62, 396);
   330	  context.textAlign = 'left';
   331	
   332	  context.fillStyle = '#16202a';
   333	  context.font = `700 38px ${FONT_BARLOW}`;
   334	  drawWrapped(context, original ? data.original : data.slop, 108, 380, 500, 44, 'left');
   335	  // The metadata stays German in both states: the extension restores the creator's content and
   336	  // leaves the viewer's own interface language alone.
   337	  context.fillStyle = '#5b6670';
   338	  context.font = `500 26px ${FONT_BARLOW}`;
   339	  context.fillText(data.meta, 108, 478);
   340	
   341	  const badge = original ? BADGE.original : BADGE.translated;
   342	  context.font = '700 22px system-ui, sans-serif';
   343	  const badgeWidth = context.measureText(badge).width + 30;
   344	  fillRoundedRect(context, 108, 522, badgeWidth, 40, 20, accent);
   345	  context.fillStyle = original ? '#1a1408' : '#ffffff';
   346	  context.fillText(badge, 123, 530);
   347	}
   348	
   349	function drawWrapped(
   350	  context: CanvasRenderingContext2D,
   351	  text: string,
   352	  x: number,
   353	  y: number,
   354	  maxWidth: number,
   355	  lineHeight: number,
   356	  align: CanvasTextAlign,
   357	): number {
   358	  context.textAlign = align;
   359	  const words = text.split(' ');
   360	  let line = '';
   361	  let lineY = y;
   362	  words.forEach((word) => {
   363	    const candidate = line ? `${line} ${word}` : word;
   364	    if (line && context.measureText(candidate).width > maxWidth) {
   365	      context.fillText(line, x, lineY);
   366	      line = word;
   367	      lineY += lineHeight;
   368	    } else {
   369	      line = candidate;
   370	    }
   371	  });
   372	  if (line) {
   373	    context.fillText(line, x, lineY);
   374	    lineY += lineHeight;
   375	  }
   376	  return lineY;
   377	}
   378	
   379	function roundedPath(
   380	  context: CanvasRenderingContext2D,
   381	  x: number,
   382	  y: number,
   383	  width: number,
   384	  height: number,
   385	  radius: number,
   386	): void {
   387	  context.beginPath();
   388	  if (typeof context.roundRect === 'function') {
   389	    context.roundRect(x, y, width, height, radius);
   390	  } else {
   391	    context.rect(x, y, width, height);
   392	  }
   393	}
   394	
   395	function fillRoundedRect(
   396	  context: CanvasRenderingContext2D,
   397	  x: number,
   398	  y: number,
   399	  width: number,
   400	  height: number,
   401	  radius: number,
   402	  colour: string,
   403	): void {
   404	  context.fillStyle = colour;
   405	  roundedPath(context, x, y, width, height, radius);
   406	  context.fill();
   407	}

