   397	    const leaf = new PlaneGeometry(LEAF_WIDTH, LEAF_LENGTH, 2, 8);
   398	    leaf.deleteAttribute('uv');
   399	    const position = leaf.getAttribute('position');
   400	    for (let k = 0; k < position.count; k++) {
   401	      // From the root (t = 0) to the tip (t = 1): widest a little past the middle, pointed at both
   402	      // ends, curling forwards along its length and cupped across it.
   403	      const y = position.getY(k) + LEAF_LENGTH / 2;
   404	      const t = y / LEAF_LENGTH;
