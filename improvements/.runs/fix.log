    39	export function createPosterMaterial(
    40	  project: Project,
    41	  options: PosterOptions = {},
    42	): MeshBasicMaterial {
    43	  const canvas = document.createElement('canvas');
    44	  canvas.width = CANVAS_WIDTH;
    45	  canvas.height = CANVAS_HEIGHT;
    46	  const context = canvas.getContext('2d');
    47	  if (!context) {
    48	    return new MeshBasicMaterial({ color: 0x141b17 });
    49	  }
    50	
    51	  const redraw = () => drawPoster(context, project, options);
    52	  redraw();
    53	
    54	  const texture = new CanvasTexture(canvas);
    55	  texture.colorSpace = SRGBColorSpace;
    56	
    57	  const fonts = document.fonts;
    58	  if (fonts) {
    59	    Promise.all(FONT_LOADS.map((font) => fonts.load(font))).then(
    60	      () => {
    61	        redraw();
    62	        texture.needsUpdate = true;
    63	      },
    64	      () => undefined,
    65	    );
    66	  }
    67	
    68	  return new MeshBasicMaterial({ map: texture });
    69	}
