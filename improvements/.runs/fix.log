    96	    faceMaterial.userData['slopMap'] = this.slopTexture;
    97	    faceMaterial.userData['uWipe'] = this.wipeUniform;
    98	
    99	    const face = new Mesh(new PlaneGeometry(FACE_WIDTH, FACE_HEIGHT), faceMaterial);
   100	    face.name = 'feed-card-face';
   101	    face.position.set(0, FACE_Y, FACE_Z);
   102	    this.object.add(face);
   103	  }
   104	
   105	  get original(): boolean {
   106	    return this.wipeUniform.value > 0.5;
   107	  }
   108	
   109	  get wipe(): number {
   110	    return this.wipeUniform.value;
   111	  }
   112	
   113	  setOriginal(on: boolean, delaySeconds = 0): void {
   114	    this.target = on ? 1 : 0;
   115	    this.delay = Math.max(0, delaySeconds);
   116	    if (this.reducedMotion()) {
   117	      this.delay = 0;
   118	      this.setWipe(this.target);
   119	    }
   120	  }
   121	
   122	  update(dt: number): void {
   123	    if (this.reducedMotion()) {
   124	      this.delay = 0;
   125	      this.setWipe(this.target);
   126	      return;
   127	    }
   128	
   129	    let remaining = Math.max(0, dt);
   130	    if (this.delay > 0) {
   131	      if (remaining <= this.delay) {
   132	        this.delay -= remaining;
   133	        return;
   134	      }
   135	      remaining -= this.delay;
   136	      this.delay = 0;
   137	    }
   138	
   139	    if (remaining === 0 || this.wipeUniform.value === this.target) {
   140	      return;
   141	    }
   142	    const distance = Math.min(
   143	      remaining * WIPE_RATE,
   144	      Math.abs(this.target - this.wipeUniform.value),
