     4	/** CSS-pixel dimensions of poster layout. */
     5	export const POSTER_WIDTH = 620;
     6	export const POSTER_HEIGHT = 387.5;
     7	
     8	const POSTER_SCALE = 2;
     9	const CANVAS_WIDTH = POSTER_WIDTH * POSTER_SCALE;
    10	const CANVAS_HEIGHT = Math.ceil(POSTER_HEIGHT) * POSTER_SCALE;
    11	const PADDING_X = 32;
