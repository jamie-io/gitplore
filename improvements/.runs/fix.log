   382	/** Leaves in one cluster, spread evenly around the root. */
   383	const CLUSTER_LEAVES = 7;
   384	/** One leaf's width and length, metres at scale 1. */
   385	const LEAF_WIDTH = 0.34;
   386	const LEAF_LENGTH = 1.25;
   387	
   388	/**
   389	 * Seven long leaves arching out of one root: the jungle's instanced undergrowth and, hung upside
   390	 * down, its canopy. Unlike the props above it is smooth-shaded and uncoloured: indexed, with one
   391	 * normal per corner so light rolls across each curved blade, and tinted per instance. It is the
   392	 * same every time; the variety comes from each instance's scale, tilt and colour.
   393	 */
   394	export function leafCluster(): BufferGeometry {
   395	  const leaves: BufferGeometry[] = [];
