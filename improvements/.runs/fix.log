   242	function createCardTexture(data: FeedCardData, original: boolean): CanvasTexture {
   243	  const canvas = document.createElement('canvas');
   244	  canvas.width = CANVAS_WIDTH;
   245	  canvas.height = CANVAS_HEIGHT;
   246	  const context = canvas.getContext('2d');
   247	  const texture = new CanvasTexture(canvas);
   248	  texture.colorSpace = SRGBColorSpace;
   249	  texture.anisotropy = 8;
   250	  if (context) {
   251	    drawCard(context, data, original);
   252	    // Drawn at once in the fallback faces, and again once the self-hosted fonts are in.
   253	    const fonts = document.fonts;
   254	    if (fonts) {
   255	      Promise.all(CARD_FONTS.map((font) => fonts.load(font))).then(
   256	        () => {
   257	          drawCard(context, data, original);
   258	          texture.needsUpdate = true;
   259	        },
   260	        () => undefined,
   261	      );
   262	    }
   263	  }
   264	  return texture;
   265	}
