   136	function drawChips(
   137	  context: CanvasRenderingContext2D,
   138	  tags: readonly string[],
   139	  x: number,
   140	  maxWidth: number,
   141	  bottom: number,
   142	): void {
   143	  const chipHeight = 19;
   144	  const chipGap = 6;
   145	  const chips = tags.map((tag) => ({
   146	    tag,
   147	    width: context.measureText(tag).width + 14,
   148	  }));
   149	  const rows: { tag: string; width: number }[][] = [[]];
   150	  let rowWidth = 0;
   151	  chips.forEach((chip) => {
   152	    const nextWidth = rowWidth ? rowWidth + chipGap + chip.width : chip.width;
   153	    if (rowWidth && nextWidth > maxWidth) {
   154	      rows.push([]);
   155	      rowWidth = 0;
   156	    }
   157	    rows[rows.length - 1].push(chip);
   158	    rowWidth += rowWidth ? chipGap + chip.width : chip.width;
   159	  });
   160	
   161	  const y = bottom - rows.length * chipHeight - (rows.length - 1) * chipGap;
   162	  rows.forEach((row, rowIndex) => {
   163	    let chipX = x;
   164	    const chipY = y + rowIndex * (chipHeight + chipGap);
   165	    row.forEach((chip) => {
   166	      strokeRoundedRect(context, chipX, chipY, chip.width, chipHeight, 4, '#3a463f');
   167	      context.fillStyle = '#f4efe4';
   168	      context.fillText(chip.tag, chipX + 7, chipY + 3);
   169	      chipX += chip.width + chipGap;
   170	    });
   171	  });
   172	}
