    47	/** A flat-coloured, non-indexed, uv-free copy ready to merge: every part of a prop looks like this. */
    48	export function paint(geometry: BufferGeometry, color: number | Color): BufferGeometry {
    49	  const flat = geometry.index ? geometry.toNonIndexed() : geometry;
    50	  flat.deleteAttribute('uv');
    51	  flat.deleteAttribute('normal');
    52	
    53	  const colour = new Color(color);
    54	  const colours = new Float32Array(flat.getAttribute('position').count * 3);
    55	  for (let i = 0; i < colours.length; i += 3) {
    56	    colours[i] = colour.r;
    57	    colours[i + 1] = colour.g;
    58	    colours[i + 2] = colour.b;
    59	  }
    60	  flat.setAttribute('color', new BufferAttribute(colours, 3));
    61	  return flat;
    62	}
