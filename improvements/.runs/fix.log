   346	/** Banana-like broad leaves on short stalks: the jungle's mid-height undergrowth. */
   347	export function bigLeafPlant(seed: number): BufferGeometry {
   348	  const random = seededRandom(seed);
   349	  const parts: BufferGeometry[] = [];
   350	  for (let i = 0; i < 6; i++) {
   351	    const stalk = between(random, 0.9, 1.3);
   352	    const yaw = (i / 6) * Math.PI * 2 + random() * 0.5;
   353	    parts.push(
