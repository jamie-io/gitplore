   286	/** A leaning palm: six trunk segments bending one way, a crown of drooping fronds, coconuts. */
   287	export function palmTree(seed: number): BufferGeometry {
   288	  const random = seededRandom(seed);
   289	  const bend = between(random, 0.04, 0.1);
   290	  const parts: BufferGeometry[] = [];
   291	  let x = 0;
   292	  let y = 0;
   293	  for (let i = 0; i < 6; i++) {
   294	    const tilt = bend * i;
   295	    const radius = 0.22 - i * 0.015;
   296	    const segment = new CylinderGeometry(radius - 0.015, radius, 1.2, 6)
   297	      .translate(0, 0.6, 0)
   298	      .rotateZ(-tilt)
   299	      .translate(x, y, 0);
   300	    parts.push(paint(segment, i % 2 ? 0x8a7355 : 0x7a6449));
   301	    x += 1.2 * Math.sin(tilt);
   302	    y += 1.2 * Math.cos(tilt);
   303	  }
   304	  for (let i = 0; i < 8; i++) {
   305	    const frond = blade(
   306	      3.2,
   307	      0.35,
   308	      -between(random, 0.2, 0.45),
   309	      (i / 8) * Math.PI * 2 + random() * 0.3,
   310	    );
   311	    parts.push(paint(frond.translate(x, y, 0), i % 2 ? 0x4f8f3a : 0x5c9c42));
   312	  }
   313	  for (let i = 0; i < 3; i++) {
   314	    const angle = (i / 3) * Math.PI * 2;
   315	    parts.push(
   316	      paint(
   317	        new IcosahedronGeometry(0.16, 0).translate(
   318	          x + Math.sin(angle) * 0.25,
   319	          y - 0.25,
   320	          Math.cos(angle) * 0.25,
   321	        ),
   322	        0x5a4a2a,
   323	      ),
   324	    );
   325	  }
   326	  return assemble(parts);
   327	}
