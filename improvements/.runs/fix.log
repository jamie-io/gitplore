    64	/** Merges painted parts into one faceted geometry with one normal per face. */
    65	export function assemble(parts: readonly BufferGeometry[]): BufferGeometry {
    66	  const merged = mergeGeometries([...parts], false);
    67	  if (!merged) {
    68	    throw new Error('flora parts do not share the same attributes');
    69	  }
    70	  parts.forEach((part) => part.dispose());
    71	  // Non-indexed, so each triangle gets its own normal: the faceted low-poly look without the
    72	  // `flatShading` derivative trick that misbehaves under SwiftShader (HANDOFF §5.6).
    73	  merged.computeVertexNormals();
    74	  merged.computeBoundingBox();
    75	  merged.computeBoundingSphere();
    76	  return merged;
    77	}
