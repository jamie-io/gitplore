   358	  }
   359	
   360	  get interactables(): readonly Interactable[] {
   361	    return (this.cachedInteractables ??= [
   362	      ...(this.environment.interactables ?? []),
   363	      ...this.parts.flatMap((part) => part.interactables ?? []),
   364	    ]);
   365	  }
   366	
   367	  init(ctx: WorldContext): void {
   368	    this.environment.init(ctx);
   369	    this.parts.forEach((part) => part.init(ctx));
