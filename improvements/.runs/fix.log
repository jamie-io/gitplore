   183	  const originalLines = wrappedLines(context, comparison.with, textWidth);
   184	  const boxHeight = (lines: number) => 10 + 10 + 12 + lines * (18 * 1.2) + 3;
   185	  const slopHeight = boxHeight(slopLines.length);
   186	  const originalHeight = boxHeight(originalLines.length);
