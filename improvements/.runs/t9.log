    17	  /** Seconds from lighting until the explorer takes the lantern off its hook. */
    18	  carryDelay: 0.9,
    19	  /** Metres a second the ring spreads. */
    20	  ringSpeed: 8,
    21	  /** The ring stops growing here (map 1400 px). */
    22	  ringMax: 1400 * MAP_SCALE,
    23	  /** The ring shows while smaller than this, fading out towards it (map 1300 px). */
