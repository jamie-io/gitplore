+    if (this.air) {
+      this.air.clearing.radius.value = 0;
+      if (this.air.clearing.glow) {
+        this.air.clearing.glow.value = 0;
+      }
+    }
+    this.offers = [this.igniteOffer];
+    this.offersBase = null;
+    player.teleport(
+      this.onGround(SPAWN.position).setY(
+        this.environment.ground.heightAt(SPAWN.position.x, SPAWN.position.z) +
+          PLAYER_EYE_HEIGHT,
