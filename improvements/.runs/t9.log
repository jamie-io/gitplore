   195	export class ProjectPanel {
   196	  readonly slug = input<string>();
   197	
   198	  private readonly content = inject(ContentService);
   199	  private readonly router = inject(Router);
   200	  private readonly store = inject(WorldStore);
   201	
   202	  protected readonly contentReady = this.content.loaded;
   203	  protected readonly project = computed(() => this.content.bySlug(this.slug()));
   204	  protected readonly demoUrl = computed(() => {
   205	    const demo = this.project()?.demo;
   206	    return demo?.kind === 'iframe' ? demo.url : null;
   207	  });
   208	
   209	  protected readonly readme = inject(ReadmeService).readme(
   210	    computed(() => {
   211	      const project = this.project();
   212	      return project?.readme?.kind === 'bundled' ? project.slug : undefined;
   213	    }),
   214	    inject(Injector),
   215	  );
   216	
   217	  protected close(): void {
   218	    void this.router.navigate(['/p', this.slug()]);
   219	  }
   220	
   221	  /** Hands the demo request to `WorldPage`, which owns the player and the `SceneDirector` (§5). */
   222	  protected tryInWorld(slug: string): void {
   223	    // An explicit click on the demo counts as starting the world; no extra gate after it.
   224	    this.store.markStarted();
   225	    this.store.requestDemo(slug);
   226	    this.close();
   227	  }
   228	}

