   148	  }
   149	
   150	  /** The HUD's state line, e.g. `Deslopify an · Entslopt 8/8`. */
   151	  get statusLine(): string {
   152	    return `Deslopify ${this.state} · Entslopt ${this.clearedCards}/${this.wipes.length}`;
   153	  }
   154	
   155	  cardWipe(index: number): number {
   156	    return this.wipes[index] ?? 0;
   157	  }
   158	
   159	  /** A card shows its original once its wipe is past half way. */
   160	  cardOriginal(index: number): boolean {
   161	    return this.cardWipe(index) > 0.5;
   162	  }
   163	
   164	  /** Whether (x, z) is cleared: inside the lantern's light, or inside a ring that is on. */
   165	  isCleared(x: number, z: number): boolean {
   166	    const light = this.light;
   167	    if (light && Math.hypot(x - light.x, z - light.z) < light.radius) {
   168	      return true;
   169	    }
   170	    return (
   171	      this.ringActive && Math.hypot(x - this.ringOrigin.x, z - this.ringOrigin.z) < this.ringRadius
   172	    );
   173	  }
   174	
   175	  update(dt: number, frame: FlowFrame): void {
   176	    const seconds = Number.isFinite(dt) ? Math.max(0, dt) : 0;
   177	    const reduced = this.reducedMotion();
   178	    const { player } = frame;
   179	    this.light = frame.light && frame.light.radius > 0 ? frame.light : null;
   180	
   181	    const post = this.options.lanternPost;
   182	    if (
   183	      this.lanternPhase === 'unlit' &&
