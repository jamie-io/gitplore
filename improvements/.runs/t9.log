   172	export class ProjectMenu {
   173	  /** Slug of the project the visitor wants to be taken to. */
   174	  readonly travel = output<string>();
   175	
   176	  private readonly store = inject(WorldStore);
   177	
   178	  protected readonly projects = inject(ContentService).projects;
   179	
   180	  protected isCurrent(slug: string): boolean {
   181	    return this.store.currentProject() === slug;
   182	  }
   183	
   184	  protected distanceLabel(slug: string): string | null {
   185	    const distance = this.store.travelDistances().get(slug);
   186	    return distance === undefined ? null : `${Math.round(distance)} m entfernt`;
   187	  }
   188	
   189	  protected openLink(slug: string): readonly string[] {
   190	    return this.isCurrent(slug) ? ['/p', slug, 'info'] : ['/p', slug];
   191	  }
   192	
   193	  protected travelTo(slug: string): void {
   194	    if (this.isCurrent(slug)) {
   195	      return;
   196	    }
   197	
   198	    this.travel.emit(slug);
   199	    this.close();
   200	  }
   201	
   202	  protected close(): void {
   203	    this.store.setMenuOpen(false);
   204	  }
   205	}
