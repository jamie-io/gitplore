    68	/** Drives the real controller and the figure together, which is the only honest walk cycle. */
    69	function walk(
    70	  explorer: Explorer,
    71	  player: PlayerController,
    72	  frames: number,
    73	  intent: Partial<MoveIntent> = {},
    74	  colliders: readonly Collider[] = [],
    75	): void {
    76	  for (let i = 0; i < frames; i++) {
    77	    player.update(FRAME, { ...NO_INTENT, ...intent }, FLAT, colliders);
    78	    explorer.sync(player, FRAME);
    79	  }
    80	}
    81	
    82	/** A player already stood in front of the figure, so the next `sync` is a real step, not a spawn. */
    83	function standing(explorer: Explorer, phase = 0): PlayerController {
    84	  const player = new PlayerController();
    85	  player.teleport(new Vector3(0, PLAYER_EYE_HEIGHT, 0));
    86	  player.grounded = true;
    87	  player.stridePhase = phase;
    88	  explorer.sync(player, FRAME);
