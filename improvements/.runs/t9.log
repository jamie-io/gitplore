    45	/** A named joint of the figure, which is how a test reaches one without opening the class up. */
    46	function joint(explorer: Explorer, name: string): Object3D {
    47	  const found = explorer.object.getObjectByName(name);
    48	  if (!found) {
    49	    throw new Error(`no joint called ${name}`);
    50	  }
    51	  return found;
    52	}
