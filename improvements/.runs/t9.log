#!/usr/bin/env node

import { existsSync, readFileSync, unlinkSync, writeFileSync } from 'node:fs';
import { mkdir } from 'node:fs/promises';
import { homedir, platform as currentPlatform } from 'node:os';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';
import { spawn, spawnSync } from 'node:child_process';

const MCP_PACKAGE = '@playwright/mcp@0.0.81';
const DEFAULT_PORT = 9334;
const DEFAULT_PROFILE_NAME = 'ub-codex-playwright';
const DEFAULT_START_URL = 'about:blank';
const PID_FILE_NAME = '.browser.pid';
const CDP_HOST = '127.0.0.1';

const BACKGROUND_FLAGS = [
  '--disable-backgrounding-occluded-windows',
  '--disable-renderer-backgrounding',
  '--disable-background-timer-throttling',
];

function defaultProfileDir(env, platformName, homeDir) {
  if (env.UB_PLAYWRIGHT_PROFILE?.trim()) {
    return env.UB_PLAYWRIGHT_PROFILE.trim();
  }

  if (platformName === 'darwin') {
    return join(homeDir, 'Library', 'Application Support', DEFAULT_PROFILE_NAME);
  }

  const stateDir = env.XDG_STATE_HOME?.trim() || join(homeDir, '.local', 'state');
  return join(stateDir, DEFAULT_PROFILE_NAME);
}

function defaultBrowserExecutable(platformName) {
  if (platformName === 'darwin') {
    return firstExisting([
      '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
      '/Applications/Chromium.app/Contents/MacOS/Chromium',
      'google-chrome',
    ]);
  }

  if (platformName === 'win32') {
    return firstExisting([
      'C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe',
      'C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe',
      'chrome.exe',
    ]);
  }

  return firstExisting([
    '/usr/bin/chromium',
    '/usr/bin/chromium-browser',
    'chromium',
    'google-chrome',
  ]);
}

function firstExisting(candidates) {
  return candidates.find((candidate) => candidate.includes('/') && existsSync(candidate))
    || candidates.find((candidate) => !candidate.includes('/') && commandExists(candidate))
    || candidates[0];
}

function commandExists(command) {
  const result = spawnSync('sh', ['-c', `command -v -- "$1" >/dev/null 2>&1`, 'command-exists', command], {
    stdio: 'ignore',
  });
  return result.status === 0;
}

function parsePort(value) {
  const raw = value ?? String(DEFAULT_PORT);
  if (!/^\d+$/.test(raw)) {
    throw new Error('UB_PLAYWRIGHT_CDP_PORT must be an integer between 1 and 65535');
  }

  const port = Number(raw);
  if (!Number.isInteger(port) || port < 1 || port > 65535) {
    throw new Error('UB_PLAYWRIGHT_CDP_PORT must be an integer between 1 and 65535');
  }
  return port;
}

export function resolveConfig(
  env = process.env,
  platformName = currentPlatform(),
  homeDir = homedir(),
  startUrlOverride,
) {
  const profileDir = defaultProfileDir(env, platformName, homeDir);
  const port = parsePort(env.UB_PLAYWRIGHT_CDP_PORT);
  const startUrl = startUrlOverride || env.UB_PLAYWRIGHT_START_URL || DEFAULT_START_URL;

  return {
    browserExecutable: env.UB_PLAYWRIGHT_BROWSER?.trim() || defaultBrowserExecutable(platformName),
    profileDir,
    port,
    startUrl,
    cdpUrl: `http://${CDP_HOST}:${port}`,
  };
}

export function buildChromiumArgs(config) {
  return [
    `--user-data-dir=${config.profileDir}`,
    `--remote-debugging-address=${CDP_HOST}`,
    `--remote-debugging-port=${config.port}`,
    '--no-first-run',
    '--no-default-browser-check',
    ...BACKGROUND_FLAGS,
    config.startUrl,
  ];
}

export function buildMcpArgs(config) {
  return [
    '-y',
    MCP_PACKAGE,
    '--cdp-endpoint',
    config.cdpUrl,
    '--shared-browser-context',
    '--host',
    CDP_HOST,
    '--allowed-hosts',
    CDP_HOST,
    '--output-dir',
    join(config.profileDir, 'mcp-output'),
  ];
}

export function isMainModule(moduleUrl, argv1 = process.argv[1]) {
  return Boolean(argv1) && pathToFileURL(argv1).href === moduleUrl;
}

function pidFile(config) {
  return join(config.profileDir, PID_FILE_NAME);
}

function readPid(config) {
  try {
    const value = Number.parseInt(readFileSync(pidFile(config), 'utf8').trim(), 10);
    return Number.isInteger(value) && value > 0 ? value : undefined;
  } catch {
    return undefined;
  }
}

function removePidFile(config) {
  try {
    unlinkSync(pidFile(config));
  } catch (error) {
    if (error?.code !== 'ENOENT') throw error;
  }
}

function processCommand(pid) {
  if (process.platform === 'linux') {
    try {
      return readFileSync(`/proc/${pid}/cmdline`, 'utf8').replaceAll('\0', ' ');
    } catch {
      return '';
    }
  }

  const result = spawnSync('ps', ['-p', String(pid), '-o', 'command='], { encoding: 'utf8' });
  return result.status === 0 ? result.stdout : '';
}

function processIsAlive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
}

