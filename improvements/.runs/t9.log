    92	/** Moves the player by hand and poses the figure for it: one step, in a chosen direction. */
    93	function step(explorer: Explorer, player: PlayerController, dx: number, dz: number): void {
    94	  player.position.x += dx;
    95	  player.position.z += dz;
    96	  explorer.sync(player, FRAME);
    97	}
