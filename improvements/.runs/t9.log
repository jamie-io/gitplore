  test('the project menu has no violations in the hub or a repository world', async ({ page }) => {
    const scanMenu = () =>
      new AxeBuilder({ page }).withTags(['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa']).analyze();

