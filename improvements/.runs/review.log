   115	/**
   116	 * Crest height at `angle`. Noise is sampled on a circle, so the ring meets itself with no seam, and
   117	 * the product of the two factors never exceeds `ring.height`.
   118	 */
   119	export function crestHeight(ring: HillRing, angle: number): number {
   120	  const x = Math.cos(angle) * 3;
   121	  const z = Math.sin(angle) * 3;
   122	  const swell = valueNoise(x, z, ring.seed);
