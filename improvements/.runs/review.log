   923	        height: this.cave.position.y + HIDDEN_PLACE_SHELL.height - this.cliffBase,
   924	        back: CAVE.z + HIDDEN_PLACE_SHELL.back - CLIFF.z,
   925	      }),
   926	      still,
   927	      [{ x: CLIFF.x, y: this.cliffBase, z: CLIFF.z, scale: 1, rotation: 0, tint: 0 }],
