    10	/** Canvas height of a label texture, in pixels; the width is measured from the text. */
    11	export const CANVAS_HEIGHT = 256;
    12	
    13	/** World height of the label plane, in metres; the width follows the canvas aspect. */
    14	export const LABEL_HEIGHT = 0.6;
    15	
    16	/** Horizontal padding, in canvas pixels, kept clear on both sides of the measured text. */
    17	export const PAD = 40;
    18	
    19	/** Barlow Semi Condensed is self-hosted (styles.scss); the stack covers the frames before it loads. */
    20	export const LABEL_FONT = '700 120px "Barlow Semi Condensed", system-ui, sans-serif';
    21	
    22	/**
    23	 * A floating text label drawn onto a canvas texture. The canvas and the plane are measured to fit
    24	 * the text, and the texture is redrawn once the web font has loaded. Returns `null` where no 2D
    25	 * context exists (headless unit tests), so callers simply skip the sign.
    26	 */
    27	export function createLabel(text: string, color: string): Mesh | null {
    28	  const canvas = document.createElement('canvas');
    29	  const context = canvas.getContext('2d');
    30	  if (!context) {
    31	    return null;
    32	  }
    33	
    34	  // The text fills `width` pixels of a power-of-two canvas; the texture repeat crops the rest, so
    35	  // the plane is exactly as wide as the text plus its padding.
    36	  const draw = (): number => {
    37	    context.font = LABEL_FONT;
    38	    const width = Math.ceil(context.measureText(text).width) + 2 * PAD;
    39	    // Resizing the canvas resets every context state, so the font goes back on before drawing.
    40	    canvas.width = MathUtils.ceilPowerOfTwo(width);
    41	    canvas.height = CANVAS_HEIGHT;
    42	    context.font = LABEL_FONT;
    43	    context.fillStyle = color;
    44	    context.fillRect(0, 0, width, CANVAS_HEIGHT);
    45	    context.fillStyle = '#ffffff';
    46	    context.textAlign = 'center';
    47	    context.textBaseline = 'middle';
    48	    context.fillText(text, width / 2, CANVAS_HEIGHT / 2);
    49	    return width;
    50	  };
    51	
    52	  const plane = (width: number): PlaneGeometry =>
    53	    new PlaneGeometry((LABEL_HEIGHT * width) / CANVAS_HEIGHT, LABEL_HEIGHT);
    54	
    55	  let width = draw();
    56	  const texture = new CanvasTexture(canvas);
    57	  texture.colorSpace = SRGBColorSpace;
    58	  texture.repeat.x = width / canvas.width;
    59	  const mesh = new Mesh(plane(width), new MeshBasicMaterial({ map: texture, transparent: false }));
    60	  mesh.name = 'label';
    61	
    62	  const redraw = (): void => {
    63	    const fitted = draw();
    64	    texture.repeat.x = fitted / canvas.width;
    65	    if (fitted !== width) {
    66	      mesh.geometry.dispose();
    67	      mesh.geometry = plane(fitted);
    68	      width = fitted;
    69	    }
    70	    texture.needsUpdate = true;
    71	  };
    72	  // Guarded for environments without the Font Loading API; a missing or failed web font leaves the
    73	  // already-drawn fallback texture in place.
    74	  document.fonts?.load(LABEL_FONT).then(redraw, () => undefined);
    75	
    76	  return mesh;
    77	}
