   514	        x: -JUNGLE_SLAB_WIDTH / 2 + edge / 2,
   515	        y: JUNGLE_SLAB_HEIGHT / 2,
   516	      },
   517	      {
   518	        name: 'moss-right',
   519	        geometry: new BoxGeometry(edge, JUNGLE_SLAB_HEIGHT, depth),
   520	        x: JUNGLE_SLAB_WIDTH / 2 - edge / 2,
   521	        y: JUNGLE_SLAB_HEIGHT / 2,
   522	      },
   523	      {
   524	        name: 'moss-top',
   525	        geometry: new BoxGeometry(JUNGLE_SLAB_WIDTH, edge, depth),
   526	        x: 0,
   527	        y: JUNGLE_SLAB_HEIGHT - edge / 2,
   528	      },
   529	    ];
