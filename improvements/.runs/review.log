   184	/**
   185	 * Splits `text` into lines no wider than `maxWidth` by `measure`, breaking at spaces. A single word
   186	 * wider than a line stands alone, and `fillText`'s own `maxWidth` squeezes it.
   187	 */
   188	export function wrapLine(
   189	  text: string,
   190	  maxWidth: number,
   191	  measure: (text: string) => number,
   192	): string[] {
   193	  const lines: string[] = [];
   194	  let current = '';
   195	  for (const word of text.split(/\s+/).filter((part) => part.length > 0)) {
   196	    const candidate = current ? `${current} ${word}` : word;
   197	    if (current && measure(candidate) > maxWidth) {
   198	      lines.push(current);
   199	      current = word;
   200	    } else {
   201	      current = candidate;
   202	    }
   203	  }
   204	  if (current) {
   205	    lines.push(current);
   206	  }
   207	  return lines;
   208	}
