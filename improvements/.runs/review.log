   116	/** A polyline as segment exclusions `halfWidth` either side of it. */
   117	function along(path: readonly Vector3[], halfWidth: number): Exclusion[] {
   118	  return path.slice(1).map((point, i) => ({
   119	    kind: 'segment' as const,
   120	    ax: path[i].x,
   121	    az: path[i].z,
   122	    bx: point.x,
   123	    bz: point.z,
   124	    halfWidth,
   125	  }));
   126	}
