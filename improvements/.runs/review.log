   852	  /** Writes the slop, thinned by the bank the camera is over, into the fog, the sky and the light. */
   853	  private breathe(camera: Vector3): void {
   854	    // 0 over the north end of the deck and beyond, 1 over its south end and beyond.
   855	    const south = smoothstep(
   856	      -BRIDGE.halfLength,
   857	      BRIDGE.halfLength,
   858	      camera.z - streamCentreZ(camera.x),
   859	    );
   860	    this.hazeNow = this.slopAmount * (NORTH_BANK_HAZE + (1 - NORTH_BANK_HAZE) * south);
   861	    if (!this.air || Math.abs(this.hazeNow - this.appliedHaze) < 1e-4) {
   862	      return;
   863	    }
   864	    const t = this.hazeNow;
   865	    const { fog, far, background, sun, hemisphere, sky } = this.air;
   866	    fog.color.copy(CLEAR.fog).lerp(SLOPPED.fog, t);
   867	    // The far hills ignore fog and mix towards their own airlight instead: the same colour.
   868	    this.backdrop.airlight.value.copy(fog.color);
   869	    fog.near = DSCHUNGEL.fog.near + (SLOP_AIR.fog.near - DSCHUNGEL.fog.near) * t;
   870	    fog.far = far + (Math.min(SLOP_AIR.fog.far, far) - far) * t;
   871	    background?.copy(fog.color);
   872	    this.shared.heightFog.value.x =
   873	      DSCHUNGEL.fog.heightDensity + (SLOP_AIR.fog.heightDensity - DSCHUNGEL.fog.heightDensity) * t;
   874	    sun.color.copy(CLEAR.sun).lerp(SLOPPED.sun, t);
   875	    this.shared.sunColor.value.copy(sun.color);
   876	    hemisphere?.color.copy(CLEAR.hemisphereSky).lerp(SLOPPED.hemisphereSky, t);
   877	    hemisphere?.groundColor.copy(CLEAR.hemisphereGround).lerp(SLOPPED.hemisphereGround, t);
   878	    if (sky) {
   879	      (sky.uniforms['zenith'].value as Color).copy(CLEAR.zenith).lerp(SLOPPED.zenith, t);
   880	      (sky.uniforms['horizon'].value as Color).copy(CLEAR.horizon).lerp(SLOPPED.horizon, t);
   881	      (sky.uniforms['below'].value as Color).copy(CLEAR.below).lerp(SLOPPED.below, t);
   882	    }
   883	    this.appliedHaze = t;
   884	  }
