    71	    // The same basis the shadow camera builds when it looks from the light at its target, so
    72	    // snapping happens on that camera's texel grid and not some other frame.
    73	    const basis = new Matrix4().lookAt(this.direction, ORIGIN, Object3D.DEFAULT_UP);
