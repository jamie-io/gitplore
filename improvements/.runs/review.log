    63	    this.reducedMotion = motionFlag(options.reducedMotion);
    64	    this.object.name = 'slop-vines';
    65	    this.object.userData['vineCount'] = this.anchors.length;
    66	
    67	    const random = seededRandom(options.seed);
    68	    this.anchors.forEach((anchor, index) => {
    69	      const length = between(random, 3.6, 5);
    70	      const points = Array.from({ length: VINE_POINTS }, (_, pointIndex) => {
    71	        const progress = pointIndex / (VINE_POINTS - 1);
    72	        const curl = progress * progress;
    73	        return new Vector3(
    74	          Math.sin(progress * 5 + index) * 0.18 * progress +
    75	            Math.sin(progress * 2.4 + index) * 0.04 * curl,
    76	          -progress * length,
    77	          Math.cos(progress * 4 + index) * 0.14 * progress +
    78	            Math.sin(progress * 3 + index) * 0.03 * curl,
    79	        );
