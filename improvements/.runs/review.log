   124	 */
   125	export function buildTerminalPages(project: Project): readonly TerminalPage[] {
   126	  const pages: TerminalPage[] = [
   127	    {
   128	      title: REPOSITORY_LABELS.project,
   129	      lines: [project.title, ...(project.summary ? [project.summary] : []), project.repoUrl],
   130	    },
   131	  ];
   132	  const section = (title: string, lines: readonly string[]) => {
   133	    for (let start = 0; start < lines.length; start += TERMINAL_LINES_PER_PAGE) {
   134	      pages.push({ title, lines: lines.slice(start, start + TERMINAL_LINES_PER_PAGE) });
   135	    }
   136	  };
   137	
   138	  const languages = repositoryLanguages(project);
   139	  if (languages.length > 0) {
   140	    section(REPOSITORY_LABELS.languages, languages.map(formatLanguageLine));
   141	  }
   142	
   143	  const activity = repositoryCommitActivity(project);
   144	  if (activity && activity.total > 0) {
   145	    section(REPOSITORY_LABELS.commits, formatCommitActivityLines(activity));
   146	  }
   147	
   148	  const releases = repositoryReleases(project);
   149	  if (releases.length > 0) {
   150	    section(REPOSITORY_LABELS.releases, releases.map(formatReleaseLine));
   151	  }
   152	
   153	  const metrics: string[] = [];
   154	  const count = (label: string, value: number | undefined) => {
   155	    if (value !== undefined && Number.isFinite(value) && value > 0) {
   156	      metrics.push(`${label}: ${formatInteger(value)}`);
   157	    }
   158	  };
   159	  const date = (label: string, value: string | undefined) => {
   160	    const formatted = formatOptionalDate(value);
   161	    if (formatted !== undefined) {
   162	      metrics.push(`${label}: ${formatted}`);
   163	    }
   164	  };
   165	  count(REPOSITORY_LABELS.stars, project.stars);
   166	  count(REPOSITORY_LABELS.forks, project.forks);
   167	  count(REPOSITORY_LABELS.openIssues, project.openIssues);
   168	  if (project.license) {
   169	    metrics.push(`${REPOSITORY_LABELS.license}: ${project.license}`);
   170	  }
   171	  date(REPOSITORY_LABELS.created, project.createdAt);
   172	  date(REPOSITORY_LABELS.firstCommit, project.firstCommitAt);
   173	  date(REPOSITORY_LABELS.lastPush, project.pushedAt);
   174	  section(REPOSITORY_LABELS.metrics, metrics);
   175	
   176	  return pages;
   177	}
