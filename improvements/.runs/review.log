   637	function drawJungleControl(
   638	  context: CanvasRenderingContext2D,
   639	  key: string,
   640	  label: string,
   641	  right: number,
   642	  footerY: number,
   643	): { readonly left: number } {
   644	  const keyWidth = context.measureText(key).width + JUNGLE_KEYCAP_PADDING * 2;
   645	  const labelWidth = context.measureText(label).width;
   646	  const totalWidth = keyWidth + JUNGLE_KEYCAP_LABEL_GAP + labelWidth;
   647	  const left = right - totalWidth;
   648	  const top = footerY - JUNGLE_KEYCAP_HEIGHT + 4;
   649	
   650	  context.strokeStyle = JUNGLE_INK;
   651	  context.lineWidth = 2;
   652	  context.beginPath?.();
   653	  if (typeof context.roundRect === 'function') {
   654	    context.roundRect(left, top, keyWidth, JUNGLE_KEYCAP_HEIGHT, JUNGLE_KEYCAP_RADIUS);
   655	  } else {
   656	    context.rect?.(left, top, keyWidth, JUNGLE_KEYCAP_HEIGHT);
   657	  }
   658	  context.stroke?.();
   659	  context.fillStyle = JUNGLE_INK;
   660	  context.textAlign = 'center';
   661	  context.fillText(key, left + keyWidth / 2, footerY - 8);
   662	  context.textAlign = 'left';
   663	  context.fillText(label, left + keyWidth + JUNGLE_KEYCAP_LABEL_GAP, footerY - 8);
   664	  return { left };
   665	}
