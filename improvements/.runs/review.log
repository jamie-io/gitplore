     1	import { MAP_SCALE } from '../../environments/jungle-layout';
     2	
     3	/**
     4	 * The Deslopify walk as a state machine, free of three.js and of the render loop: the lantern, the
     5	 * arch that installs the extension, the ring that spreads the clearing, the haze and the feed
     6	 * cards. The scene feeds it the player and the lantern's light each frame and draws what it says.
     7	 *
     8	 * The rules are the top-down flow prototype's (#2a of the design handoff), converted to metres with
     9	 * the layout's `MAP_SCALE`: ratios, orders and trigger conditions survive, sizes are physical. Two
    10	 * numbers come from the 3D Lookdev instead, because the map's would be far too large in a walked
    11	 * world: the lantern lights within 2.2 m (the map's 44 px would be 8 m), and the ring runs at
    12	 * 8 m/s (the map's 340 px/s would be 61 m/s).
    13	 */
    14	export const FLOW = {
    15	  /** Metres from the lantern's post within which it lights by itself. */
    16	  ignitionRadius: 2.2,
    17	  /** Seconds from lighting until the explorer takes the lantern off its hook. */
    18	  carryDelay: 0.9,
    19	  /** Metres a second the ring spreads. */
    20	  ringSpeed: 8,
    21	  /** The ring stops growing here (map 1400 px). */
    22	  ringMax: 1400 * MAP_SCALE,
    23	  /** The ring shows while smaller than this, fading out towards it (map 1300 px). */
    24	  ringVisible: 1300 * MAP_SCALE,
    25	  /** The haze is gone once the ring is this wide (map 700 px). */
    26	  hazeSpan: 700 * MAP_SCALE,
    27	  /** The haze closes this fraction of its gap to the target per second. */
    28	  hazeEase: 2,
    29	  /** Card wipe progress per second in the light, and back out of it. */
    30	  cardOn: 2.2,
    31	  cardOff: 1.1,
    32	} as const;
    33	
    34	/** A point on the ground plane, in world metres. */
    35	export interface FlowPoint {
    36	  readonly x: number;
    37	  readonly z: number;
    38	}
    39	
    40	/** The lantern's light: where it is and how far it reaches this frame (0 when out). */
    41	export interface FlowLight extends FlowPoint {
    42	  readonly radius: number;
    43	}
    44	
    45	export interface FlowFrame {
    46	  readonly player: FlowPoint;
    47	  readonly light: FlowLight | null;
    48	}
    49	
    50	/** Unlit on its hook, lit on its hook (for `carryDelay`), then carried by the explorer. */
    51	export type LanternPhase = 'unlit' | 'lit' | 'carried';
    52	
    53	/** What the HUD calls the extension's state. */
    54	export type DeslopifyState = 'noch nicht' | 'an' | 'aus';
    55	
    56	export interface DeslopifyFlowOptions {
    57	  readonly lanternPost: FlowPoint;
    58	  /** Where the first ring starts. */
    59	  readonly arch: FlowPoint;
    60	  /** Where every later ring starts, once the wall switches Deslopify back on. */
    61	  readonly wall: FlowPoint;
    62	  /** Every feed card, in the order the scene numbers them. */
    63	  readonly cards: readonly FlowPoint[];
    64	  /** Whether a player standing at (x, z) is under the arch. */
    65	  readonly underArch: (x: number, z: number) => boolean;
    66	  /** Read live: switched on mid-transition, it snaps the ring, the haze and the cards. */
    67	  readonly reducedMotion?: () => boolean;
    68	}
    69	
    70	export class DeslopifyFlow {
    71	  private readonly options: DeslopifyFlowOptions;
    72	  private readonly reducedMotion: () => boolean;
    73	  private readonly wipes: number[];
    74	
    75	  private lanternPhase: LanternPhase = 'unlit';
    76	  private lanternLit = false;
    77	  private litFor = 0;
    78	  private installedFlag = false;
    79	  private wallFlag = true;
    80	  private ringOrigin: FlowPoint;
    81	  private ringRadius = 0;
    82	  private hazeValue = 1;
    83	  private light: FlowLight | null = null;
    84	
    85	  constructor(options: DeslopifyFlowOptions) {
    86	    this.options = options;
    87	    this.reducedMotion = options.reducedMotion ?? (() => false);
    88	    this.wipes = options.cards.map(() => 0);
    89	    this.ringOrigin = options.arch;
    90	  }
    91	
    92	  get lantern(): LanternPhase {
    93	    return this.lanternPhase;
    94	  }
    95	
    96	  /** Whether the lantern gives light: from the moment it lights until E puts it out. */
    97	  get lanternOn(): boolean {
    98	    return this.lanternLit;
    99	  }
   100	
   101	  /** Set once the player has walked under the arch; nothing but `reset` unsets it. */
   102	  get installed(): boolean {
   103	    return this.installedFlag;
   104	  }
   105	
   106	  /** The wall's switch. Only means anything once installed. */
   107	  get wallOn(): boolean {
   108	    return this.wallFlag;
   109	  }
   110	
   111	  /** Whether the wall offers its switch: only once Deslopify is installed. */
   112	  get wallAvailable(): boolean {
   113	    return this.installedFlag;
   114	  }
   115	
   116	  get state(): DeslopifyState {
   117	    if (!this.installedFlag) {
   118	      return 'noch nicht';
   119	    }
   120	    return this.wallFlag ? 'an' : 'aus';
   121	  }
   122	
   123	  /** The current ring: where it started and how far it has spread, in metres. */
   124	  get ring(): { readonly origin: FlowPoint; readonly radius: number } {
   125	    return { origin: this.ringOrigin, radius: this.ringRadius };
   126	  }
   127	
   128	  /** The ring clears only while Deslopify is installed and switched on. */
   129	  get ringActive(): boolean {
   130	    return this.installedFlag && this.wallFlag;
   131	  }
   132	
   133	  get ringVisible(): boolean {
   134	    return this.ringActive && this.ringRadius < FLOW.ringVisible;
   135	  }
   136	
   137	  get ringOpacity(): number {
   138	    return this.ringVisible ? Math.max(0, 1 - this.ringRadius / FLOW.ringVisible) : 0;
   139	  }
   140	
   141	  /** How much slop hangs in the air, 1 … 0. */
   142	  get haze(): number {
   143	    return this.hazeValue;
   144	  }
   145	
   146	  get clearedCards(): number {
   147	    return this.wipes.filter((wipe) => wipe > 0.5).length;
   148	  }
   149	
   150	  /** The HUD's state line, e.g. `Deslopify an · Entslopt 8/8`. */
   151	  get statusLine(): string {
   152	    return `Deslopify ${this.state} · Entslopt ${this.clearedCards}/${this.wipes.length}`;
   153	  }
   154	
   155	  cardWipe(index: number): number {
   156	    return this.wipes[index] ?? 0;
   157	  }
   158	
   159	  /** A card shows its original once its wipe is past half way. */
   160	  cardOriginal(index: number): boolean {
   161	    return this.cardWipe(index) > 0.5;
   162	  }
   163	
   164	  /** Whether (x, z) is cleared: inside the lantern's light, or inside a ring that is on. */
   165	  isCleared(x: number, z: number): boolean {
   166	    const light = this.light;
   167	    if (light && Math.hypot(x - light.x, z - light.z) < light.radius) {
   168	      return true;
   169	    }
   170	    return (
   171	      this.ringActive && Math.hypot(x - this.ringOrigin.x, z - this.ringOrigin.z) < this.ringRadius
   172	    );
   173	  }
   174	
   175	  update(dt: number, frame: FlowFrame): void {
   176	    const seconds = Number.isFinite(dt) ? Math.max(0, dt) : 0;
   177	    const reduced = this.reducedMotion();
   178	    const { player } = frame;
   179	    this.light = frame.light && frame.light.radius > 0 ? frame.light : null;
   180	
   181	    const post = this.options.lanternPost;
   182	    if (
   183	      this.lanternPhase === 'unlit' &&
   184	      Math.hypot(player.x - post.x, player.z - post.z) < FLOW.ignitionRadius
   185	    ) {
   186	      this.igniteLantern();
   187	    }
   188	    if (this.lanternPhase === 'lit') {
   189	      this.litFor += seconds;
   190	      if (reduced || this.litFor >= FLOW.carryDelay) {
   191	        this.lanternPhase = 'carried';
   192	      }
   193	    }
   194	
   195	    if (!this.installedFlag && this.options.underArch(player.x, player.z)) {
   196	      this.install(this.options.arch);
   197	    }
   198	
   199	    if (this.ringActive) {
   200	      this.ringRadius = reduced
   201	        ? FLOW.ringMax
   202	        : Math.min(FLOW.ringMax, this.ringRadius + FLOW.ringSpeed * seconds);
   203	    }
   204	    const haze = this.ringActive ? Math.max(0, 1 - this.ringRadius / FLOW.hazeSpan) : 1;
   205	    this.hazeValue = reduced
   206	      ? haze
   207	      : this.hazeValue + (haze - this.hazeValue) * Math.min(1, seconds * FLOW.hazeEase);
   208	
   209	    this.options.cards.forEach((card, index) => {
   210	      const cleared = this.isCleared(card.x, card.z);
   211	      this.wipes[index] = reduced
   212	        ? cleared
   213	          ? 1
   214	          : 0
   215	        : clamp01(this.wipes[index] + (cleared ? FLOW.cardOn : -FLOW.cardOff) * seconds);
   216	    });
   217	  }
   218	
   219	  /** Lights the lantern on its hook. `false` if it was lit already. */
   220	  igniteLantern(): boolean {
   221	    if (this.lanternPhase !== 'unlit') {
   222	      return false;
   223	    }
   224	    this.lanternPhase = 'lit';
   225	    this.lanternLit = true;
   226	    this.litFor = 0;
   227	    return true;
   228	  }
   229	
   230	  /** Puts the carried lantern out, or lights it again. `false` unless it is carried. */
   231	  toggleLantern(): boolean {
   232	    if (this.lanternPhase !== 'carried') {
   233	      return false;
   234	    }
   235	    this.lanternLit = !this.lanternLit;
   236	    return true;
   237	  }
   238	
   239	  /**
   240	   * Installs Deslopify with a ring from `origin`, as walking under the arch does; the project
   241	   * menu's "try it in the world" does it from the wall. `false` if it was installed already.
   242	   */
   243	  install(origin: FlowPoint = this.options.arch): boolean {
   244	    if (this.installedFlag) {
   245	      return false;
   246	    }
   247	    this.installedFlag = true;
   248	    this.wallFlag = true;
   249	    this.startRing(origin);
   250	    this.igniteLantern();
   251	    return true;
   252	  }
   253	
   254	  /**
   255	   * The wall's E: off lets the slop grow back over the whole jungle, on sends a new ring out from
   256	   * the wall. Does nothing, and says so with `false`, before Deslopify is installed.
   257	   */
   258	  toggleWall(): boolean {
   259	    if (!this.installedFlag) {
   260	      return false;
   261	    }
   262	    this.wallFlag = !this.wallFlag;
   263	    if (this.wallFlag) {
   264	      this.startRing(this.options.wall);
   265	    }
   266	    return true;
   267	  }
   268	
   269	  /** Back to the arrival's state: the lantern on its hook, nothing installed, all slop. */
   270	  reset(): void {
   271	    this.lanternPhase = 'unlit';
   272	    this.lanternLit = false;
   273	    this.litFor = 0;
   274	    this.installedFlag = false;
   275	    this.wallFlag = true;
   276	    this.ringOrigin = this.options.arch;
   277	    this.ringRadius = 0;
   278	    this.hazeValue = 1;
   279	    this.light = null;
   280	    this.wipes.fill(0);
   281	  }
   282	
   283	  private startRing(origin: FlowPoint): void {
   284	    this.ringOrigin = origin;
   285	    this.ringRadius = 0;
   286	  }
   287	}
   288	
   289	function clamp01(value: number): number {
   290	  return Math.min(1, Math.max(0, value));
   291	}

