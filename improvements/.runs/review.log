  1073	/**
  1074	 * Stands every plant of `mesh` from `seed`: kept off the stage floor, small where visitors walk
  1075	 * and up to three times the size out in the groves, leaning a little, in one of five greens. Every
  1076	 * candidate draws the same numbers whether it is kept or not, like `scatter`.
  1077	 */
  1078	function standPlants(mesh: InstancedMesh, seed: number): void {
  1079	  const random = seededRandom(seed);
  1080	  // The capacity, not `count`: an earlier stand may have drawn fewer.
  1081	  const capacity = mesh.instanceMatrix.count;
  1082	  const attempts = capacity * 30;
  1083	  let placed = 0;
  1084	
  1085	  for (let attempt = 0; attempt < attempts && placed < capacity; attempt++) {
  1086	    const { x, z } = besideTrails(random, PLANT_REACH);
  1087	    const growth = random() ** 1.6;
  1088	    const stretch = between(random, 0.8, 1.3);
  1089	    const tiltX = (random() - 0.5) * 0.25;
  1090	    const turn = random() * Math.PI * 2;
  1091	    const tiltZ = (random() - 0.5) * 0.25;
  1092	    const hue = (random() - 0.5) * 0.03;
  1093	    const lightness = (random() - 0.5) * 0.08;
  1094	    if (isExcluded(x, z, STAGE_FLOOR)) {
  1095	      continue;
  1096	    }
  1097	
  1098	    const size = 0.55 + growth * (isExcluded(x, z, STAGE) ? 0.55 : 2);
  1099	    cursor.position.set(x, jungleHeightAt(x, z) - 0.05, z);
  1100	    cursor.rotation.set(tiltX, turn, tiltZ);
  1101	    cursor.scale.set(size, size * stretch, size);
  1102	    cursor.updateMatrix();
  1103	    mesh.setMatrixAt(placed, cursor.matrix);
  1104	    leafColour.setHex(LEAF_GREENS[placed % LEAF_GREENS.length]).offsetHSL(hue, 0, lightness);
  1105	    mesh.setColorAt(placed, leafColour);
  1106	    placed++;
  1107	  }
  1108	
  1109	  // Too crowded a stage to place them all: draw only those that found a spot.
  1110	  mesh.count = placed;
  1111	  finish(mesh);
  1112	}
