  pointAlong,
  streamCentreZ,
} from './jungle-layout';
import { HIDDEN_PLACE_SHELL, HiddenPlace } from './props/hidden-place';
import { LightShafts } from './light-shafts';
import { DSCHUNGEL, applyMood, clearMood } from './mood';
