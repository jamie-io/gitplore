   940	      ...variants(palmTree, [4, 5], this.groves.palms, leafy(7.2), { name: 'palm', ...tall }),
   941	      ...variants(treeFern, [6, 7], this.groves.ferns, leafy(3.5), { name: 'tree-fern', ...tall }),
   942	      ...variants(mossyBoulder, [8, 9], this.groves.boulders, still, {
