    22	/** What `forEachResource` reports; every callback is optional, so callers pay only for what they use. */
    23	export interface ResourceVisitor {
    24	  geometry?: (geometry: BufferGeometry) => void;
    25	  /** Return `false` to skip the material's own textures. */
    26	  material?: (material: Material) => boolean | void;
    27	  texture?: (texture: Texture) => void;
    28	}
    29	
    30	/**
    31	 * Walks every geometry, material and texture the scene graph under `root` references.
    32	 *
    33	 * Disposing, refcounting and counting all need the same traversal and differ only in what they do
    34	 * at the leaves, so the rule for *where* resources hide lives here once.
    35	 */
    36	export function forEachResource(root: Object3D, visit: ResourceVisitor): void {
    37	  root.traverse((object) => {
    38	    const mesh = object as Partial<Mesh>;
    39	    if (mesh.geometry) {
    40	      visit.geometry?.(mesh.geometry);
    41	    }
    42	
    43	    const material = mesh.material;
    44	    if (Array.isArray(material)) {
    45	      material.forEach((entry) => visitMaterial(entry, visit));
    46	    } else if (material) {
    47	      visitMaterial(material, visit);
    48	    }
    49	  });
    50	}
    51	
    52	function visitMaterial(material: Material, visit: ResourceVisitor): void {
    53	  if (visit.material?.(material) === false || !visit.texture) {
    54	    return;
    55	  }
    56	
    57	  // Every map is a plain property on the material, so this catches `map`, `normalMap`,
    58	  // `emissiveMap` and anything a future material adds without listing them by hand.
    59	  for (const value of Object.values(material)) {
    60	    if (value instanceof Texture) {
    61	      visit.texture(value);
    62	    }
    63	  }
    64	}
