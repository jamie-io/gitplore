+      ? index
+      : Math.round((index * (buckets.length - 1)) / (JUNGLE_RAIL_POST_COUNT - 1));
+  const value = buckets[sourceIndex];
+  return typeof value === 'number' && Number.isFinite(value) ? Math.max(0, value) : 0;
+}
+
+function pathFrame(
+  fromPoint: Vector3,
+  toPoint: Vector3,
+): {
+  side: Vector3;
+  yaw: number;
