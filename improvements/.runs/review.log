+        geometry: new BoxGeometry(edge, JUNGLE_SLAB_HEIGHT, depth),
+        x: -JUNGLE_SLAB_WIDTH / 2 + edge / 2,
+        y: JUNGLE_SLAB_HEIGHT / 2,
+      },
+      {
+        name: 'moss-right',
+        geometry: new BoxGeometry(edge, JUNGLE_SLAB_HEIGHT, depth),
+        x: JUNGLE_SLAB_WIDTH / 2 - edge / 2,
+        y: JUNGLE_SLAB_HEIGHT / 2,
+      },
+      {
+        name: 'moss-top',
+        geometry: new BoxGeometry(JUNGLE_SLAB_WIDTH, edge, depth),
+        x: 0,
+        y: JUNGLE_SLAB_HEIGHT - edge / 2,
+      },
