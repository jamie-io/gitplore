   166	      this.budPosition.set(vine.endpoint.x, vine.endpoint.y * scale, vine.endpoint.z);
   167	      this.budPosition.applyEuler(vine.group.rotation);
   168	      this.budHelper.position.copy(vine.anchor).add(this.budPosition);
   169	      this.budHelper.scale.setScalar(1);
   170	      this.budHelper.rotation.set(0, 0, 0);
