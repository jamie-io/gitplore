     1	import { BoxGeometry, CylinderGeometry, Group, Mesh, MeshStandardMaterial } from 'three';
     2	import { disposeObject3D } from '@engine/dispose';
     3	import { createLabel } from '../../landmarks/base/label';
     4	
     5	const PLANK_MARGIN = 0.15;
     6	const PLANK_DEPTH = 0.08;
     7	const POST_COLOUR = 0x5a3d27;
     8	
     9	/** Mounts a measured label on a small wooden plank sign. The group origin is ground level. */
    10	export function createPlankSign(text: string, colour: string, postHeight = 1): Group | null {
    11	  const label = createLabel(text, colour);
    12	  if (!label) {
    13	    return null;
    14	  }
    15	
    16	  label.geometry.computeBoundingBox();
    17	  const bounds = label.geometry.boundingBox;
    18	  if (!bounds) {
    19	    disposeObject3D(label);
    20	    return null;
    21	  }
    22	
    23	  const labelWidth = bounds.max.x - bounds.min.x;
    24	  const labelHeight = bounds.max.y - bounds.min.y;
    25	  const plankWidth = labelWidth + PLANK_MARGIN;
    26	  const plankHeight = labelHeight + PLANK_MARGIN;
    27	  const group = new Group();
    28	  group.name = 'plank-sign';
    29	
    30	  const post = new Mesh(
    31	    new CylinderGeometry(0.035, 0.05, postHeight, 6),
    32	    new MeshStandardMaterial({ color: POST_COLOUR, roughness: 0.85 }),
    33	  );
    34	  post.name = 'plank-sign-post';
    35	  post.position.y = postHeight / 2;
    36	
    37	  const plank = new Mesh(
    38	    new BoxGeometry(plankWidth, plankHeight, PLANK_DEPTH),
    39	    new MeshStandardMaterial({ color: POST_COLOUR, roughness: 0.85 }),
    40	  );
    41	  plank.name = 'plank-sign-plank';
    42	  plank.position.y = postHeight + plankHeight / 2;
    43	
    44	  label.name = 'plank-sign-label';
    45	  label.scale.setScalar(1);
    46	  label.position.set(0, postHeight + plankHeight / 2, PLANK_DEPTH / 2 + 0.002);
    47	
    48	  group.add(post, plank, label);
    49	  return group;
    50	}
