    58	/**
    59	 * Where the terminal and the seed lever stand: beside the walk from the arrival point to the
    60	 * exhibit, never on it, each turned to face the walk and the visitor coming along it. The ridge and the
    61	 * release cairns keep within about 3.3 m of the centre line and the pillar row stands at the walk's
    62	 * midpoint, so both toys stay clear of them. Deterministic: the same world always puts them in the
    63	 * same place.
    64	 */
    65	export function toyPlacements(
    66	  arrival: Vector3,
    67	  exhibit: Vector3,
    68	  blocked: readonly Collider[],
    69	): { readonly terminal: ToyPlacement; readonly lever: ToyPlacement } {
    70	  const axis = new Vector3(exhibit.x - arrival.x, 0, exhibit.z - arrival.z);
    71	  const length = axis.length();
    72	  if (length > 0) {
    73	    axis.divideScalar(length);
    74	  } else {
    75	    axis.set(0, 0, -1);
    76	  }
    77	  // The same side vector the commit ridge and the release markers use; they stand on its minus side.
    78	  const side = new Vector3(-axis.z, 0, axis.x);
    79	  const place = (along: number, sign: number): ToyPlacement => {
    80	    const position = arrival
    81	      .clone()
    82	      .setY(0)
    83	      .addScaledVector(axis, length * along)
    84	      .addScaledVector(side, sign * TOY_SIDE_OFFSET);
    85	    // Face back across the walk and a little towards the arrival point.
    86	    const front = side.clone().multiplyScalar(-sign).addScaledVector(axis, -0.6);
    87	    return { position, rotationY: Math.atan2(front.x, front.z) };
    88	  };
    89	  const first = (candidates: readonly (readonly [number, number])[]): ToyPlacement => {
    90	    const spots = candidates.map(([along, sign]) => place(along, sign));
    91	    return (
    92	      spots.find((spot) => gap(spot.position.x, spot.position.z, blocked) > TOY_REACH + TOY_ROOM) ??
    93	      spots[0]
    94	    );
    95	  };
    96	  return { terminal: first(TERMINAL_SPOTS), lever: first(LEVER_SPOTS) };
