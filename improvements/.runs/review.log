    float dy = toFrag.y;
    // A flat ray or a zero falloff reduces the integral to the density at the camera's height.
    float along = (k > 1e-4 && abs(dy) > 1e-3)
      ? (exp(-k * cameraPosition.y) - exp(-k * worldPosition.y)) / (k * dy)
      : exp(-k * cameraPosition.y);
