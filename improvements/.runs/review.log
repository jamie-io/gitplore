   155	/** A segment `reach` either side of a slot, square to the way it faces. */
   156	function sideways(place: Slot, reach: number, halfWidth: number): Exclusion {
   157	  const across = [Math.cos(place.yaw), -Math.sin(place.yaw)];
   158	  return {
   159	    kind: 'segment',
   160	    ax: place.position.x - across[0] * reach,
   161	    az: place.position.z - across[1] * reach,
   162	    bx: place.position.x + across[0] * reach,
   163	    bz: place.position.z + across[1] * reach,
   164	    halfWidth,
   165	  };
   166	}
