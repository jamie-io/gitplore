   133	 */
   134	function shoulderShare(ring: HillRing, angle: number): number {
   135	  const x = Math.cos(angle) * 5;
   136	  const z = Math.sin(angle) * 5;
   137	  return 0.3 + 0.35 * valueNoise(x, z, ring.seed + 2);
