    22	
    23	const SEGMENTS = 144;
    24	/** How far below the ground the inner foot sinks, so no gap shows at the terrain's edge. */
    25	const FOOT_DEPTH = 6;
    26	
    27	// The haze as airlight: a hill this far off is seen through a column of lit air, so a share of what
    28	// reaches the eye is the horizon colour whatever the slope's own lighting does. Baking the haze
    29	// into the vertex colour alone was not enough: a slope turned away from a low sun still went as
    30	// dark as its shaded colour, and the ring read as a wall. Blended before tone mapping, in linear
    31	// light, from the same per-face haze the colours were baked with.
    32	const VERTEX_DECLARATIONS = /* glsl */ `
    33	attribute float aHaze;
    34	varying float vBackdropHaze;
    35	#include <common>`;
    36	const VERTEX_HAZE = /* glsl */ `
    37	#include <begin_vertex>
    38	vBackdropHaze = aHaze;`;
    39	const FRAGMENT_DECLARATIONS = /* glsl */ `
    40	uniform vec3 backdropHorizon;
    41	varying float vBackdropHaze;
    42	#include <common>`;
    43	const FRAGMENT_AIRLIGHT = /* glsl */ `
    44	gl_FragColor.rgb = mix(gl_FragColor.rgb, backdropHorizon, vBackdropHaze);
    45	#include <tonemapping_fragment>`;
