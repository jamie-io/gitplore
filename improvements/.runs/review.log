   250	/** The low tier draws half as many: additive overdraw is what SwiftShader feels most. */
   251	function pointCount(count: number, quality: QualitySettings): number {
   252	  const lowTier = quality.shaderDetail === 0;
   253	  return Math.max(0, Math.round(count * quality.propDensity * (lowTier ? 0.5 : 1)));
   254	}
   255	
   256	function layout(
   257	  options: MotesOptions,
   258	  count: number,
   259	): { positions: Float32Array; seeds: Float32Array } {
   260	  const { area, followCamera, seed } = options;
   261	  const random = seededRandom(seed);
   262	  const positions = new Float32Array(count * 3);
   263	  const seeds = new Float32Array(count * 2);
   264	
   265	  for (let i = 0; i < count; i++) {
   266	    if (followCamera) {
   267	      // Relative to the camera: a box in x/z, the height band as given.
   268	      positions[i * 3] = between(random, -area.radius, area.radius);
   269	      positions[i * 3 + 2] = between(random, -area.radius, area.radius);
   270	    } else {
   271	      // Uniform over the disc: the square root keeps the centre from crowding.
   272	      const r = Math.sqrt(random()) * area.radius;
   273	      const angle = between(random, 0, Math.PI * 2);
   274	      positions[i * 3] = area.x + Math.cos(angle) * r;
   275	      positions[i * 3 + 2] = area.z + Math.sin(angle) * r;
   276	    }
   277	    const ground =
   278	      !followCamera && options.heightAt
