const FRAGMENT_DECLARATIONS = /* glsl */ `
#include <fog_pars_fragment>
varying vec3 vAtmosWorld;
uniform vec3 atmosSunDirection;
uniform vec3 atmosSunColor;
uniform vec3 atmosHeightFog;
