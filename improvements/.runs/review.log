    47	/**
    48	 * Rings of distant hills that hide where the walkable ground ends. Their haze is baked into their
    49	 * colours and they ignore fog, so they read the same at every tier's draw distance.
    50	 */
    51	export class Backdrop implements WorldObject {
    52	  readonly id = 'backdrop';
    53	
    54	  /**
    55	   * The airlight every ring's shader mixes towards, by identity: a world whose air changes colour
    56	   * (the jungle's slop) moves this and the hills follow. Starts as the horizon they were built for.
    57	   */
    58	  readonly airlight: { value: Color };
