   250	function waterColliders(): Collider[] {
   251	  const colliders: Collider[] = [];
   252	  const span = (from: number, to: number) => {
   253	    for (let x = from; x < to - 1e-9; x += 4) {
   254	      const end = Math.min(x + 4, to);
   255	      let low = Infinity;
   256	      let high = -Infinity;
   257	      for (let sample = x; sample < end + 0.25; sample += 0.5) {
   258	        const centre = streamCentreZ(Math.min(sample, end));
   259	        low = Math.min(low, centre);
   260	        high = Math.max(high, centre);
