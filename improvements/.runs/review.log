   898	    // liana hangs below its origin.
   899	    const still = withAtmosphere(
   900	      new MeshStandardMaterial({ vertexColors: true, roughness: 0.95, metalness: 0 }),
   901	      this.shared,
   902	    );
   903	    const tall = { castShadow: shadows, receiveShadow: shadows, tint: foliageTint, sink: 0.15 };
