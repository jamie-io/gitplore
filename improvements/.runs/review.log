  1028	/** The walked lines, each with its length, for spreading things along all of them evenly. */
  1029	const WALKED = PATHS.map((path) => ({
  1030	  path,
  1031	  length: path.slice(1).reduce((sum, point, i) => sum + point.distanceTo(path[i]), 0),
  1032	}));
  1033	const WALKED_LENGTH = WALKED.reduce((sum, { length }) => sum + length, 0);
