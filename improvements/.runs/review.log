   152	  private applyVisuals(): void {
   153	    let totalGrow = 0;
   154	    for (let index = 0; index < this.vines.length; index++) {
   155	      const vine = this.vines[index]!;
   156	      const scale = vine.grow;
   157	      totalGrow += scale;
   158	      vine.group.scale.set(1, scale, 1);
   159	      if (this.reducedMotion()) {
   160	        vine.group.rotation.set(0, 0, 0);
   161	      } else {
