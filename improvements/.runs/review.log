   114	    this.buds = new InstancedMesh(this.budGeometry, this.budMaterial, this.vines.length);
   115	    this.buds.name = 'slop-vine-buds';
   116	    this.buds.castShadow = true;
   117	    this.buds.userData['radius'] = BUD_RADIUS;
   118	    this.object.add(this.buds);
   119	    this.applyVisuals();
   120	  }
