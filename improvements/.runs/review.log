   603	function drawJungleFooter(
   604	  context: CanvasRenderingContext2D,
   605	  page: number,
   606	  pages: number,
   607	  footerY: number,
   608	): void {
   609	  const rowWidth = pages * JUNGLE_DOT_SIZE + Math.max(0, pages - 1) * JUNGLE_DOT_GAP;
   610	  const firstCenter = (CANVAS_WIDTH - rowWidth) / 2 + JUNGLE_DOT_SIZE / 2;
   611	  for (let index = 0; index < pages; index++) {
   612	    context.fillStyle = index === page ? JUNGLE_ACCENT : JUNGLE_MUTED;
   613	    const centerX = firstCenter + index * (JUNGLE_DOT_SIZE + JUNGLE_DOT_GAP);
   614	    const centerY = footerY - 52;
   615	    if (
   616	      typeof context.beginPath === 'function' &&
   617	      typeof context.arc === 'function' &&
   618	      typeof context.fill === 'function'
   619	    ) {
   620	      context.beginPath();
   621	      context.arc(centerX, centerY, JUNGLE_DOT_SIZE / 2, 0, Math.PI * 2);
   622	      context.fill();
   623	    } else {
   624	      context.fillRect(
   625	        centerX - JUNGLE_DOT_SIZE / 2,
   626	        centerY - JUNGLE_DOT_SIZE / 2,
   627	        JUNGLE_DOT_SIZE,
   628	        JUNGLE_DOT_SIZE,
   629	      );
   630	    }
   631	  }
   632	  const right = CANVAS_WIDTH - MARGIN;
   633	  const exit = drawJungleControl(context, 'Esc', 'verlassen', right, footerY);
   634	  drawJungleControl(context, '↑↓', 'blättern', exit.left - JUNGLE_FOOTER_GAP, footerY);
   635	}
