+  const axis = new Vector3(toPoint.x - fromPoint.x, 0, toPoint.z - fromPoint.z);
+  if (axis.lengthSq() === 0) {
+    axis.set(0, 0, -1);
+  } else {
+    axis.normalize();
+  }
+  return {
+    side: new Vector3(-axis.z, 0, axis.x),
+    yaw: Math.atan2(axis.x, axis.z),
+  };
