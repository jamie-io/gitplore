    59	    this.direction = shared.sunDirection.value;
    60	    this.normalBias = options.normalBias ?? SHADOW_NORMAL_BIAS;
    61	    this.light = new DirectionalLight(mood.sun.color, mood.sun.intensity);
    62	    this.light.name = 'sun';
    63	    this.light.target.name = 'sun-target';
    64	    this.hemisphere = new HemisphereLight(
    65	      mood.hemisphere.sky,
    66	      mood.hemisphere.ground,
    67	      mood.hemisphere.intensity,
    68	    );
    69	    this.hemisphere.name = 'sky-light';
