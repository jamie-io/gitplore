+      typeof value === 'number' && Number.isFinite(value) ? Math.max(highest, value) : highest,
+    0,
+  );
+  for (let index = 0; index < JUNGLE_RAIL_POST_COUNT; index++) {
+    const point = from
+      .clone()
+      .lerp(to, index / (JUNGLE_RAIL_POST_COUNT - 1))
