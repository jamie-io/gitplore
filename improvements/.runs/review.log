   119	function rotatedAabb(
   120	  origin: Vector3,
   121	  centreX: number,
   122	  centreZ: number,
   123	  halfWidth: number,
   124	  halfDepth: number,
   125	  rotationY: number,
   126	): Extract<Collider, { kind: 'aabb' }> {
   127	  const rotation = new Euler(0, rotationY, 0);
   128	  const corners = [-halfWidth, halfWidth].flatMap((x) =>
   129	    [-halfDepth, halfDepth].map((z) =>
   130	      new Vector3(centreX + x, 0, centreZ + z).applyEuler(rotation).add(origin),
   131	    ),
   132	  );
   133	
   134	  return {
   135	    kind: 'aabb',
   136	    minX: Math.min(...corners.map((corner) => corner.x)),
   137	    maxX: Math.max(...corners.map((corner) => corner.x)),
   138	    minZ: Math.min(...corners.map((corner) => corner.z)),
   139	    maxZ: Math.max(...corners.map((corner) => corner.z)),
   140	  };
   141	}
