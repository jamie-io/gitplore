   991	/** Metres either side of their spot the release cairns spread. */
   992	const CAIRN_SPREAD = 2.5;
   993	
   994	/**
   995	 * The line the release cairns are laid beside, so they stand across `slot`, square to the way it
   996	 * faces: `ReleaseMarkers` lays them `MARKER_OFFSET` behind the line, so the line runs that far in
   997	 * front of the spot, towards the trail, and their version labels face it.
   998	 */
   999	function cairnLine(slot: Slot): ToyLine {
  1000	  const across = new Vector3(Math.cos(slot.yaw), 0, -Math.sin(slot.yaw));
  1001	  const centre = slot.position
  1002	    .clone()
  1003	    .addScaledVector(new Vector3(Math.sin(slot.yaw), 0, Math.cos(slot.yaw)), MARKER_OFFSET);
  1004	  return {
  1005	    from: centre.clone().addScaledVector(across, -CAIRN_SPREAD),
  1006	    to: centre.clone().addScaledVector(across, CAIRN_SPREAD),
  1007	  };
  1008	}
