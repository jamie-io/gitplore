    99	/** Metres from (x, z) to the nearest collider's surface. */
   100	function gap(x: number, z: number, colliders: readonly Collider[]): number {
   101	  let nearest = Infinity;
   102	  for (const collider of colliders) {
   103	    const distance =
   104	      collider.kind === 'cylinder'
   105	        ? Math.hypot(x - collider.x, z - collider.z) - collider.radius
   106	        : Math.hypot(
   107	            Math.max(collider.minX - x, 0, x - collider.maxX),
   108	            Math.max(collider.minZ - z, 0, z - collider.maxZ),
   109	          );
   110	    nearest = Math.min(nearest, distance);
   111	  }
   112	  return nearest;
   113	}
