     3	/**
     4	 * Releases every GPU resource reachable from `root` and detaches it from the scene graph.
     5	 *
     6	 * Three keeps geometries, materials and textures alive until they are disposed explicitly, so this
     7	 * is the single choke point that keeps `renderer.info.memory` flat across enter/exit cycles
     8	 * (IMPLEMENTATION_PLAN.md §2). Textures marked `userData.managed` belong to a texture provider
     9	 * (`AssetService` from M5) that refcounts and disposes them itself; they are left alone here.
    10	 */
    11	
    12	/** Marks a texture as owned by a provider, so `disposeObject3D` never frees it out from under others. */
    13	export function markManaged<T extends Texture | Material | BufferGeometry>(resource: T): T {
    14	  resource.userData['managed'] = true;
    15	  return resource;
    16	}
    17	
    18	function isManaged(resource: { userData: Record<string, unknown> }): boolean {
    19	  return resource.userData['managed'] === true;
    20	}
