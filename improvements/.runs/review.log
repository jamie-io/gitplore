    39	export function createPosterMaterial(
    40	  project: Project,
    41	  options: PosterOptions = {},
    42	): MeshBasicMaterial {
    43	  const canvas = document.createElement('canvas');
    44	  canvas.width = CANVAS_WIDTH;
    45	  canvas.height = CANVAS_HEIGHT;
    46	  const context = canvas.getContext('2d');
    47	  if (!context) {
    48	    return new MeshBasicMaterial({ color: 0x141b17 });
    49	  }
    50	
    51	  const redraw = () => drawPoster(context, project, options);
    52	  redraw();
