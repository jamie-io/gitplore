  1035	/**
  1036	 * A point up to `reach` either side of a walked line, spread evenly along all of them: every call
  1037	 * draws exactly two numbers.
  1038	 */
  1039	function besideTrails(random: Random, reach: number): { x: number; z: number } {
  1040	  let along = random() * WALKED_LENGTH;
  1041	  const offset = (random() * 2 - 1) * reach;
  1042	  for (const { path, length } of WALKED) {
  1043	    if (along <= length || path === WALKED[WALKED.length - 1].path) {
  1044	      const point = pointAlong(path, along);
  1045	      const behind = pointAlong(path, along - 0.5);
  1046	      const ahead = pointAlong(path, along + 0.5);
  1047	      const dx = ahead.x - behind.x;
  1048	      const dz = ahead.z - behind.z;
  1049	      const length = Math.hypot(dx, dz) || 1;
  1050	      return { x: point.x - (dz / length) * offset, z: point.z + (dx / length) * offset };
  1051	    }
  1052	    along -= length;
  1053	  }
  1054	  return { x: 0, z: 0 };
  1055	}
