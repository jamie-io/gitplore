+    const post = new Mesh(postGeometry, postMaterial);
+    post.name = `rail-post-${index}`;
+    post.scale.y = height;
+    post.position.set(point.x, ground + height / 2, point.z);
+    group.add(post);
+    const cap = new Mesh(
