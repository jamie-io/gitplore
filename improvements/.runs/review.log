     4	/**
     5	 * Cosine of the widest angle between the view direction and an interactable that still counts as
     6	 * facing it (IMPLEMENTATION_PLAN.md §2).
     7	 */
     8	export const FACING_THRESHOLD = 0.4;
     9	
    10	/**
    11	 * Picks, every frame, the nearest interactable the player is close to and looking at, and reports
    12	 * it only when the pick changes — so the store is written rarely, never per frame.
    13	 */
    14	export class InteractionSystem {
    15	  onChange: ((nearby: Interactable | null) => void) | null = null;
    16	
    17	  private current: Interactable | null = null;
    18	
    19	  get nearby(): Interactable | null {
    20	    return this.current;
    21	  }
    22	
    23	  update(player: PlayerController, interactables: readonly Interactable[]): void {
    24	    this.set(pick(player, interactables));
    25	  }
    26	
    27	  reset(): void {
    28	    this.set(null);
    29	  }
    30	
    31	  private set(next: Interactable | null): void {
    32	    if (next === this.current) {
    33	      return;
    34	    }
    35	
    36	    this.current = next;
    37	    this.onChange?.(next);
    38	  }
    39	}
    40	
    41	function pick(
    42	  player: PlayerController,
    43	  interactables: readonly Interactable[],
    44	): Interactable | null {
    45	  // Forward is -Z at yaw 0, as in the player controller.
    46	  const forwardX = -Math.sin(player.yaw);
    47	  const forwardZ = -Math.cos(player.yaw);
    48	
    49	  let best: Interactable | null = null;
    50	  let bestDistance = Infinity;
    51	
    52	  for (const candidate of interactables) {
    53	    const dx = candidate.position.x - player.position.x;
    54	    const dz = candidate.position.z - player.position.z;
    55	    const distance = Math.hypot(dx, dz);
    56	
    57	    if (distance > candidate.radius || distance >= bestDistance || distance === 0) {
    58	      continue;
    59	    }
    60	
    61	    const facing = (dx * forwardX + dz * forwardZ) / distance;
    62	    if (facing < FACING_THRESHOLD) {
    63	      continue;
    64	    }
    65	
    66	    best = candidate;
    67	    bestDistance = distance;
    68	  }
    69	
    70	  return best;
    71	}
