   282	        kind: 'cylinder',
   283	        x: a.x + (b.x - a.x) * t,
   284	        z: a.z + (b.z - a.z) * t,
   285	        radius: BROOK.band,
   286	      });
   287	    }
   288	  }
   289	  const mouth = BROOK.path[BROOK.path.length - 1];
   290	  colliders.push({ kind: 'cylinder', x: mouth.x, z: mouth.z, radius: BROOK.band });
   291	  return colliders;
   292	}
