     7	/** One ring of distant hills around the origin. */
     8	export interface HillRing {
     9	  /** Distance from the origin to the crest, in metres. */
    10	  readonly radius: number;
    11	  /** Metres from the ring's inner foot to its outer foot. */
    12	  readonly depth: number;
    13	  /** Highest a crest may rise, in metres. */
    14	  readonly height: number;
    15	  /** 0 for smooth swells, 1 for jagged peaks. */
    16	  readonly roughness: number;
