    83	  fillRoundedRect(context, 0, 0, POSTER_WIDTH, POSTER_HEIGHT, 0, '#0b0f0d');
    84	  fillRoundedRect(context, 10, 10, POSTER_WIDTH - 20, POSTER_HEIGHT - 20, 6, '#141b17');
