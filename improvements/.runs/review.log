   910	          x: tree.x + Math.sin(angle) * reach,
   911	          y: tree.y + tree.scale * 11.5,
   912	          z: tree.z + Math.cos(angle) * reach,
   913	          scale: 1,
   914	          rotation: angle,
   915	          tint: ((index * 2 + k) % 7) / 7,
