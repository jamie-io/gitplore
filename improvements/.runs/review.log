   361	const MOSS = new Color(0x3f6230);
   362	const MOSS_LIT = new Color(0x5a7f38);
   363	const HOLLOW = new Color(0x26371f);
   364	const LITTER = new Color(0x5c4a31);
   365	const TRAIL = new Color(0x6a5840);
   366	const SILT = new Color(0x4a4a38);
   367	const scratch = new Color();
   368	
   369	function clamp01(value: number): number {
   370	  return Math.min(Math.max(value, 0), 1);
   371	}
   372	
   373	/** Metres from (x, z) to the nearest walked line. */
   374	function toTrail(x: number, z: number): number {
   375	  return Math.min(...PATHS.map((path) => nearestOnPath(x, z, path).distance));
   376	}
   377	
   378	/**
   379	 * The forest floor at one corner: moss, leaf litter, the trodden trails and the deck's
   380	 * approaches, and silt along the water.

--- jungle latter ---
   380	 * approaches, and silt along the water.
   381	 */
   382	export function jungleGround(x: number, z: number, height: number): Color {
   383	  scratch
   384	    .copy(HOLLOW)
   385	    .lerp(MOSS, clamp01((height + 1.5) / 2.5))
   386	    .lerp(MOSS_LIT, clamp01(valueNoise(x * 0.08, z * 0.08, 5) - 0.45) * 1.2);
   387	  const litter = valueNoise(x * 0.3, z * 0.3, 6);
   388	  if (litter > 0.6) {
   389	    scratch.lerp(LITTER, (litter - 0.6) * 1.8);
   390	  }
   391	  const toPool = Math.hypot(x - POOL.x, z - POOL.z);
   392	  if (toPool < POOL.radius * 1.3) {
   393	    scratch.lerp(SILT, clamp01((POOL.radius * 1.3 - toPool) / (POOL.radius * 0.4)));
   394	  }
   395	  const shore = Math.min(
   396	    distanceToStream(x, z) - STREAM.halfWidth,
   397	    distanceToBrook(x, z) - BROOK.halfWidth,
   398	  );
   399	  if (shore < 1.8) {
   400	    scratch.lerp(SILT, clamp01((1.8 - shore) / 1.2));
   401	  }
   402	  const trail = toTrail(x, z);
   403	  if (trail < 1.4) {
   404	    scratch.lerp(TRAIL, (1 - trail / 1.4) * 0.8);
   405	  }
   406	  return scratch;
   407	}
