+      // ends, curling forwards along its length and cupped across it.
+      const y = position.getY(k) + LEAF_LENGTH / 2;
+      const t = y / LEAF_LENGTH;
+      const x = position.getX(k) * Math.sin(Math.PI * Math.min(t * 1.1, 1)) * (1 - t * 0.2);
