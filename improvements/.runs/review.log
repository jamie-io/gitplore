    16	/**
    17	 * Half the side of the orthographic shadow box, metres. Wide enough to take in the groves beyond
    18	 * the portal ring: with the sun 20° up a 6 m crown throws a 16 m shadow, and a box that stopped
    19	 * at the ring left every tree's shadow outside it. 6 cm texels on the strongest tier.
    20	 */
    21	const SHADOW_HALF_EXTENT = 64;
    22	/** How far along the sun direction the light sits from the box's centre. */
    23	const LIGHT_DISTANCE = 120;
    24	const SHADOW_NEAR = 1;
    25	const SHADOW_FAR = 250;
    26	/**
    27	 * Depth offsets against acne on the terrain: a small constant bias, and a normal offset that grows
    28	 * with the slope so a face lit at a grazing angle does not shadow itself.
    29	 */
    30	const SHADOW_BIAS = -0.0004;
    31	const SHADOW_NORMAL_BIAS = 0.05;
    32	
    33	const ORIGIN = new Vector3();
    34	
    35	/**
    36	 * The world's two lights: the sun as a shadow-casting directional light and the sky as a
    37	 * hemisphere light. The hemisphere's ground colour is what lights the undersides of cones and
    38	 * canopies, so it comes from the mood rather than being black.
    39	 *
    40	 * The shadow box is a fixed size and follows the visitor, snapped to whole shadow texels in light
    41	 * space: a box that slid continuously would make every shadow edge crawl while walking.
    42	 */
    43	export class Sun implements WorldObject {
    44	  readonly id = 'sun';
    45	  /** Exposed for tests. */
    46	  readonly light: DirectionalLight;
    47	
    48	  private readonly hemisphere: HemisphereLight;
    49	  /** The shared uniform's own vector, so the sun can never disagree with the shaders. */
    50	  private readonly direction: Vector3;
    51	  private readonly right = new Vector3();
    52	  private readonly up = new Vector3();
    53	  private readonly normalBias: number;
    54	  private texel = 0;
    55	
    56	  constructor(options: SunOptions) {
