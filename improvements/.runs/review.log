   954	  /**
   955	   * The leaf clusters: plants on the floor that sway and give way to the visitor, and clusters hung
   956	   * upside down under the kapok crowns. One geometry and two draw calls, the counts set by the tier.
   957	   */
   958	  private buildFoliage(quality: QualitySettings): {
   959	    readonly plants: InstancedMesh;
