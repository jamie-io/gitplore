   441	  let best = { point: path[0].clone(), distance: Infinity, along: 0 };
   442	  let walked = 0;
   443	  for (let i = 0; i < path.length - 1; i++) {
   444	    const a = path[i];
   445	    const b = path[i + 1];
   446	    const dx = b.x - a.x;
   447	    const dz = b.z - a.z;
   448	    const length = Math.hypot(dx, dz);
   449	    const t =
   450	      length > 0 ? Math.min(Math.max(((x - a.x) * dx + (z - a.z) * dz) / length ** 2, 0), 1) : 0;
