   452	    const pz = a.z + dz * t;
   453	    const distance = Math.hypot(x - px, z - pz);
   454	    if (distance < best.distance) {
   455	      best = { point: new Vector3(px, 0, pz), distance, along: walked + length * t };
   456	    }
   457	    walked += length;
   458	  }
   459	  return best;
   460	}
