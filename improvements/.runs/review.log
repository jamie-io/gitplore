   122	  update(dt: number, isCleared: (index: number, anchor: Vector3) => boolean): void {
   123	    const seconds = Math.max(0, dt);
   124	    this.time += seconds;
   125	    for (let index = 0; index < this.vines.length; index++) {
   126	      const vine = this.vines[index]!;
   127	      const cleared = isCleared(index, vine.anchor);
