  1119	  const random = seededRandom(seed);
  1120	  // The capacity, not `count`: an earlier stand may have drawn fewer.
  1121	  const capacity = mesh.instanceMatrix.count;
  1122	  const attempts = capacity * 30;
  1123	  let placed = 0;
  1124	
  1125	  for (let attempt = 0; attempt < attempts && placed < capacity; attempt++) {
  1126	    const { x, z } = besideTrails(random, CANOPY_REACH);
  1127	    const size = between(random, 2.5, 5);
  1128	    const lift = between(random, 7, 11);
  1129	    const tiltX = (random() - 0.5) * 0.6;
  1130	    const turn = random() * Math.PI * 2;
  1131	    const tiltZ = (random() - 0.5) * 0.6;
  1132	    if (isExcluded(x, z, OPEN_SKY)) {
  1133	      continue;
  1134	    }
  1135	
  1136	    const above = Math.max(lift, CANOPY_CLEARANCE + CANOPY_DROOP * size);
