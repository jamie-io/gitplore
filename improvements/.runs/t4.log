   389	    }
   390	    const page = this.pages[this.pageIndexValue];
   391	    const jungle = this.skin === 'jungle';
   392	    const width = CANVAS_WIDTH - MARGIN * 2;
   393	    context.textBaseline = 'alphabetic';
   394	    context.textAlign = 'left';
   395	    context.fillStyle = jungle ? JUNGLE_BACKGROUND : BACKGROUND;
   396	    context.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
   397	
   398	    context.fillStyle = jungle ? JUNGLE_ACCENT : ACCENT;
   399	    context.font = TITLE_FONT;
   400	    context.fillText(page.title, MARGIN, 116, width);
