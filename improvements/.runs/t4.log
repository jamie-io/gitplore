   402	
   403	    context.fillStyle = jungle ? JUNGLE_INK : INK;
   404	    context.font = jungle ? JUNGLE_BODY_FONT : BODY_FONT;
   405	    const measure = (text: string) => context.measureText(text).width;
   406	    const lines = page.lines.flatMap((line) => wrapLine(line, width, measure));
   407	    const room = jungle
   408	      ? JUNGLE_MAX_LINES
   409	      : Math.floor((FOOTER_Y - 48 - BODY_TOP) / LINE_HEIGHT) + 1;
   410	    const shown = lines.length > room ? [...lines.slice(0, room - 1), '…'] : lines;
   411	    shown.forEach((line, index) => {
   412	      context.fillText(line, MARGIN, BODY_TOP + 24 + index * LINE_HEIGHT, width);
   413	    });
