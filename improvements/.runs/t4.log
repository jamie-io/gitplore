+    expect(fillText.mock.calls.some(([text]) => String(text).startsWith('Seite '))).toBe(false);
+    expect(fillRect.mock.calls.filter(([, , width, height]) => width === 8 && height === 8)).toHaveLength(
+      4,
+    );
+
+    target.dispose();
+    context.mockRestore();
+  });
