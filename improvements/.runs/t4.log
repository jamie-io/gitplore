+  private addMossEdges(dimensions: TerminalDimensions): void {
+    const moss = new MeshStandardMaterial({ color: JUNGLE_MOSS, roughness: 1 });
+    const edge = 0.045;
+    const depth = dimensions.caseDepth + 0.018;
+    const edges = [
+      { name: 'moss-left', geometry: new BoxGeometry(edge, dimensions.caseHeight, depth), x: -dimensions.caseWidth / 2 + edge / 2, y: dimensions.screenCentre },
+      { name: 'moss-right', geometry: new BoxGeometry(edge, dimensions.caseHeight, depth), x: dimensions.caseWidth / 2 - edge / 2, y: dimensions.screenCentre },
+      { name: 'moss-top', geometry: new BoxGeometry(dimensions.caseWidth, edge, depth), x: 0, y: dimensions.screenCentre + dimensions.caseHeight / 2 - edge / 2 },
+      { name: 'moss-bottom', geometry: new BoxGeometry(dimensions.caseWidth, edge, depth), x: 0, y: dimensions.screenCentre - dimensions.caseHeight / 2 + edge / 2 },
+    ];
+    for (const item of edges) {
+      const edgeMesh = new Mesh(item.geometry, moss.clone());
+      edgeMesh.name = `${this.id}:${item.name}`;
+      edgeMesh.position.set(item.x, item.y, 0);
+      edgeMesh.castShadow = true;
+      this.group.add(edgeMesh);
+    }
+  }
+
+  private addPlankLabel(dimensions: TerminalDimensions): void {
+    const plank = new Mesh(
