+    context.fillRect(
+      margin + index * JUNGLE_DOT_GAP,
+      footerY - JUNGLE_DOT_SIZE,
+      JUNGLE_DOT_SIZE,
+      JUNGLE_DOT_SIZE,
+    );
+  }
+  context.fillStyle = JUNGLE_MUTED;
