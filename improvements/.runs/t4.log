+      { name: 'moss-bottom', geometry: new BoxGeometry(dimensions.caseWidth, edge, depth), x: 0, y: dimensions.screenCentre - dimensions.caseHeight / 2 + edge / 2 },
+    ];
+    for (const item of edges) {
