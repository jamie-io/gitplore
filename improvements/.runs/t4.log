+  private addMossEdges(dimensions: TerminalDimensions): void {
+    const moss = new MeshStandardMaterial({ color: JUNGLE_MOSS, roughness: 1 });
+    const edge = 0.045;
+    const depth = dimensions.caseDepth + 0.018;
+    const edges = [
+      { name: 'moss-left', geometry: new BoxGeometry(edge, dimensions.caseHeight, depth), x: -dimensions.caseWidth / 2 + edge / 2, y: dimensions.screenCentre },
+      { name: 'moss-right', geometry: new BoxGeometry(edge, dimensions.caseHeight, depth), x: dimensions.caseWidth / 2 - edge / 2, y: dimensions.screenCentre },
+      { name: 'moss-top', geometry: new BoxGeometry(dimensions.caseWidth, edge, depth), x: 0, y: dimensions.screenCentre + dimensions.caseHeight / 2 - edge / 2 },
+      { name: 'moss-bottom', geometry: new BoxGeometry(dimensions.caseWidth, edge, depth), x: 0, y: dimensions.screenCentre - dimensions.caseHeight / 2 + edge / 2 },
+    ];
+    for (const item of edges) {
+      const edgeMesh = new Mesh(item.geometry, moss.clone());
+      edgeMesh.name = `${this.id}:${item.name}`;
+      edgeMesh.position.set(item.x, item.y, 0);
+      edgeMesh.castShadow = true;
+      this.group.add(edgeMesh);
+    }
+  }
+
+  private addPlankLabel(dimensions: TerminalDimensions): void {
+    const plank = new Mesh(
+      new BoxGeometry(1.8, 0.42, 0.08),
+      new MeshStandardMaterial({ color: JUNGLE_WOOD, roughness: 0.9 }),
+    );
+    plank.name = `${this.id}:plank`;
+    plank.position.set(0, dimensions.screenCentre + dimensions.caseHeight / 2 + 0.34, 0);
+    const label = createLabel(this.options.project.title, '#5a3d27');
+    if (label) {
+      label.name = `${this.id}:label`;
+      label.scale.set(0.75, 0.7, 1);
+      label.position.set(0, 0, 0.045);
+      plank.add(label);
+    }
+    this.group.add(plank);
+  }
+}
+
+interface TerminalDimensions {
+  readonly screenWidth: number;
+  readonly screenHeight: number;
+  readonly screenCentre: number;
+  readonly caseWidth: number;
+  readonly caseHeight: number;
+  readonly caseDepth: number;
+}
+
+function terminalDimensions(skin: 'default' | 'jungle'): TerminalDimensions {
+  if (skin === 'jungle') {
+    return {
+      screenWidth: JUNGLE_SCREEN_WIDTH,
+      screenHeight: JUNGLE_SCREEN_HEIGHT,
+      screenCentre: JUNGLE_SCREEN_CENTRE,
+      caseWidth: JUNGLE_CASE_WIDTH,
+      caseHeight: JUNGLE_CASE_HEIGHT,
+      caseDepth: CASE_DEPTH,
+    };
+  }
+  return {
+    screenWidth: SCREEN_WIDTH,
+    screenHeight: SCREEN_HEIGHT,
+    screenCentre: SCREEN_CENTRE,
+    caseWidth: CASE_WIDTH,
+    caseHeight: CASE_HEIGHT,
+    caseDepth: CASE_DEPTH,
+  };
+}
+
+function drawJungleFooter(
+  context: CanvasRenderingContext2D,
+  page: number,
+  margin: number,
+  footerY: number,
+): void {
+  for (let index = 0; index < 4; index++) {
+    context.fillStyle = index === Math.min(page, 3) ? JUNGLE_ACCENT : JUNGLE_MUTED;
+    context.fillRect(margin + index * JUNGLE_DOT_GAP, footerY - JUNGLE_DOT_SIZE, JUNGLE_DOT_SIZE, JUNGLE_DOT_SIZE);
