+    const bodyParameters = (body.geometry as { parameters: { width: number; height: number } })
+      .parameters;
+    const screenParameters = (
+      screen.geometry as { parameters: { width: number; height: number } }
+    ).parameters;
+    const bodyLineFonts = fillText.mock.calls.filter(
+      (_call, index) => fonts[index] === '44px system-ui, sans-serif',
