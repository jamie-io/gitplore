+  page: number,
+  margin: number,
+  footerY: number,
+): void {
+  for (let index = 0; index < 4; index++) {
+    context.fillStyle = index === Math.min(page, 3) ? JUNGLE_ACCENT : JUNGLE_MUTED;
+    context.fillRect(margin + index * JUNGLE_DOT_GAP, footerY - JUNGLE_DOT_SIZE, JUNGLE_DOT_SIZE, JUNGLE_DOT_SIZE);
+  }
+  context.fillStyle = JUNGLE_MUTED;
+  context.fillText('↑↓ blättern', margin + 92, footerY);
+  context.fillText('Esc verlassen', margin + 270, footerY);
 }
 
