+      set: (value: string) => {
+        currentFont = value;
+        fonts.push(value);
+      },
+    });
+    fillText.mockImplementation((text: string) => {
+      void text;
+      fonts.push(currentFont);
+    });
+    const context = vi
+      .spyOn(HTMLCanvasElement.prototype, 'getContext')
+      .mockReturnValue(canvasContext);
+    const target = new Terminal({
