@@ -0,0 +1,145 @@
+import { CanvasTexture, MeshBasicMaterial, SRGBColorSpace } from 'three';
+import type { Project } from '@content/project.model';
+
+export const POSTER_WIDTH = 620;
+export const POSTER_HEIGHT = Math.round((POSTER_WIDTH * 10) / 16);
+
+export interface PosterComparison {
+  readonly without: string;
+  readonly with: string;
+}
+
+export interface PosterOptions {
+  readonly comparison?: PosterComparison;
+  readonly englishSummary?: string;
+  readonly kicker?: string;
+}
+
+export function createPosterMaterial(
+  project: Project,
+  options: PosterOptions = {},
+): MeshBasicMaterial {
+  const canvas = document.createElement('canvas');
+  canvas.width = POSTER_WIDTH;
+  canvas.height = POSTER_HEIGHT;
+  const context = canvas.getContext('2d');
+  if (!context) {
+    return new MeshBasicMaterial({ color: 0x141b17 });
+  }
+
+  context.fillStyle = '#0b0f0d';
+  context.fillRect(0, 0, POSTER_WIDTH, POSTER_HEIGHT);
+  context.fillStyle = '#141b17';
+  context.fillRect(10, 10, POSTER_WIDTH - 20, POSTER_HEIGHT - 20);
+  context.fillStyle = '#f4efe4';
+  context.textAlign = 'left';
+  context.textBaseline = 'top';
+
+  context.font = '10px IBM Plex Mono, monospace';
+  context.fillStyle = '#d8bf8a';
+  context.fillText(options.kicker ?? defaultKicker(project), 32, 30);
+
+  context.font = '50px Barlow, sans-serif';
+  context.fillStyle = '#f4efe4';
+  context.fillText(project.title, 32, 50);
+
+  context.font = '15px Barlow, sans-serif';
+  context.fillStyle = '#f4efe4';
+  drawWrapped(context, project.summary, 32, 122, 300, 22);
+
+  context.font = 'italic 13px Barlow, sans-serif';
+  context.fillStyle = '#c7c4ba';
+  drawWrapped(context, options.englishSummary ?? DEFAULT_ENGLISH_SUMMARY, 32, 224, 300, 19);
+
+  drawChips(context, project.tags, 358, 122);
+
+  if (options.comparison) {
+    drawComparison(context, options.comparison, 358, 196);
+  }
+
+  context.font = '13px IBM Plex Mono, monospace';
+  context.fillStyle = '#d8bf8a';
+  context.fillText(shortRepoUrl(project.repoUrl), 32, 326);
+
+  context.font = '15px Barlow, sans-serif';
+  context.fillStyle = '#f4efe4';
+  context.fillText('E Details, README & Code', 358, 326);
+
+  const texture = new CanvasTexture(canvas);
+  texture.colorSpace = SRGBColorSpace;
+  return new MeshBasicMaterial({ map: texture });
+}
+
+const DEFAULT_ENGLISH_SUMMARY =
+  'Remove AI auto-translated titles, thumbnails, descriptions, and audio from YouTube.';
+
+function defaultKicker(project: Project): string {
+  const descriptor = project.summary.split(',')[0]?.trim();
+  return descriptor ? `Projekt · ${descriptor}` : 'Projekt · Repository';
+}
+
+function shortRepoUrl(repoUrl: string): string {
+  return repoUrl.replace(/^https?:\/\//, '');
+}
+
+function drawChips(
+  context: CanvasRenderingContext2D,
+  tags: readonly string[],
+  x: number,
+  y: number,
+): void {
+  context.font = '10px IBM Plex Mono, monospace';
+  tags.forEach((tag, index) => {
+    const chipX = x + (index % 2) * 126;
+    const chipY = y + Math.floor(index / 2) * 28;
+    context.fillStyle = '#2a3b32';
+    context.fillRect(chipX, chipY, 116, 20);
+    context.fillStyle = '#f4e6c8';
+    context.fillText(tag, chipX + 8, chipY + 4);
+  });
+}
+
+function drawComparison(
+  context: CanvasRenderingContext2D,
+  comparison: PosterComparison,
+  x: number,
+  y: number,
+): void {
+  context.font = '10px IBM Plex Mono, monospace';
+  context.fillStyle = '#d8bf8a';
+  context.fillText('OHNE · WITHOUT', x, y);
+  context.fillText('MIT · WITH', x + 126, y);
+  context.font = '18px Barlow, sans-serif';
+  context.fillStyle = '#f4efe4';
+  drawWrapped(context, comparison.without, x, y + 18, 106, 21);
+  context.fillText('↓', x + 114, y + 38);
+  drawWrapped(context, comparison.with, x + 126, y + 18, 106, 21);
+}
+
+function drawWrapped(
+  context: CanvasRenderingContext2D,
+  text: string,
+  x: number,
+  y: number,
+  maxWidth: number,
+  lineHeight: number,
+): void {
+  const measure =
+    typeof context.measureText === 'function'
+      ? (line: string) => context.measureText(line).width
+      : (line: string) => line.length * 8;
+  let line = '';
+  for (const word of text.split(/\s+/)) {
+    const candidate = line ? `${line} ${word}` : word;
+    if (line && measure(candidate) > maxWidth) {
+      context.fillText(line, x, y);
+      y += lineHeight;
+      line = word;
+    } else {
+      line = candidate;
+    }
+  }
+  if (line) {
+    context.fillText(line, x, y);
+  }
+}
