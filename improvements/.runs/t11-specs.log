    const stillHandle = ctx.scene.getObjectByName('test:seed-lever:handle') as Group;
    still.interactables[0].onInteract();
    still.update(0.1);
    expect(stillHandle.rotation.z).toBe(0);
    still.dispose();
    expect(ctx.scene.children).toHaveLength(0);
  });
});

