  });

  it('stands the arriving player at the south trail’s start, facing along it', () => {
    const environment = jungle();

    expect(environment.spawn.x).toBe(SOUTH_TRAIL[0].x);
    expect(environment.spawn.z).toBe(SOUTH_TRAIL[0].z);
