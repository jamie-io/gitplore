+    const geometry = new BufferGeometry().setAttribute(
+      'position',
+      new Float32BufferAttribute(Array.from({ length: count * 3 }, (_, index) => index), 3),
+    );
+    const node = new Mesh(geometry, new MeshStandardMaterial());
+    node.name = `cairn-${variant}`;
+    model.add(node);
+  });
+  return model;
+}
