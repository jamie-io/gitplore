+      expect(bounds.max.x - bounds.min.x).toBeLessThan(3.2);
+      expect(bounds.max.y).toBeGreaterThan(0.9);
+      expect(bounds.max.y).toBeLessThan(1.4);
+      expect(bounds.min.y).toBeLessThan(0);
+      baked!.dispose();
+    }
+  });
+});
