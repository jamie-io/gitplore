+    const card = new FeedCard(FEED_CARDS[0], { reducedMotion: () => true });
+
+    card.setOriginal(true, 10);
+    expect(card.wipe).toBe(1);
+    expect(card.original).toBe(true);
+    card.setOriginal(false, 10);
+    expect(card.wipe).toBe(0);
