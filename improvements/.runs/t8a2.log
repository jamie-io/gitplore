+
+    card.dispose();
+  });
+
+  it('draws both 640 by 600 card states with canonical copy and typography', () => {
+    const canvas = canvasFixture();
+    const card = new FeedCard(FEED_CARDS[1]);
+    const maps = mapsOf(card);
