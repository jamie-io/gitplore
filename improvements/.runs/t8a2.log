    ridge.init(ctx);

    const boardwalk = ctx.scene.getObjectByName('commit-ridge') as Mesh;
    const rail = ctx.scene.getObjectByName('commit-ridge-rail');
    expect(boardwalk.userData['plankCount']).toBe(Math.floor(FROM.distanceTo(TO) / 0.32));
