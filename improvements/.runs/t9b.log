+      return;
+    }
+
+    type TestWindow = Window & {
+      __gitploreTestTeleport?: (id: string) => boolean;
+    };
+    const testWindow = window as TestWindow;
+    const teleport = (id: string) => this.director.teleportToInteractableForTest(id);
