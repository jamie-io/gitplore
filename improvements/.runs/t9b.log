    this.yaw = yaw;
    this.pitch = pitch;
    this.velocity.set(0, 0, 0);
    this.lastStep = 0;
    this.grounded = false;
    this.coyote = 0;
  }

  /** Sets a temporary vertical eye adjustment; callers clear it by passing zero. */
  setEyeHeightOffset(offset: number): void {
