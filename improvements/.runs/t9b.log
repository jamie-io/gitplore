+}
+
+/** Counts textures held by shader uniforms, including uniforms kept in material userData. */
+function collectTextures(value: unknown, textures: Set<Texture>, visited: Set<object>): void {
+  if (value instanceof Texture) {
+    textures.add(value);
+    return;
