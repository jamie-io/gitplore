      },
      measureText: (text: string) => ({ width: text.length * 12 }),
    } as unknown as CanvasRenderingContext2D;
    Object.defineProperty(context, 'font', {
      get: () => fonts.at(-1) ?? '',
      set: (value: string) => fonts.push(value),
    });
    contexts.push(context);
