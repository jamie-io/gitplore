  commitBuckets: Array.from({ length: 52 }, (_, index) => (index === 4 ? 2 : index === 51 ? 3 : 0)),
  firstCommitAt: '2026-01-02T00:00:00Z',
  createdAt: '2026-01-01T00:00:00Z',
  pushedAt: '2026-01-10T00:00:00Z',
