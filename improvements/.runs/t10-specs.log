  const length = BRIDGE.halfLength * 2;
  const planks = Math.floor(length / PLANK.pitch);
  const start = -((planks - 1) * PLANK.pitch) / 2;

  for (let i = 0; i < planks; i++) {
    const z = start + i * PLANK.pitch;

