+  context.lineWidth = 2;
+  context.beginPath();
+  context.roundRect(left, top, keyWidth, JUNGLE_KEYCAP_HEIGHT, JUNGLE_KEYCAP_RADIUS);
+  context.stroke();
+  context.fillStyle = JUNGLE_INK;
+  context.textAlign = 'center';
+  context.fillText(key, left + keyWidth / 2, footerY - 8);
