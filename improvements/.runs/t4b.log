    const load = vi.fn().mockResolvedValue([]);
    Object.defineProperty(document, 'fonts', {
      configurable: true,
      value: { load },
    });
    const target = new Terminal({
      id: 'test:jungle-fonts',
      position: new Vector3(0, 0, -2),
      ground,
      project: PROJECT,

