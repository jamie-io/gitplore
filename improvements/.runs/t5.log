+    axis.set(0, 0, -1);
+  } else {
+    axis.normalize();
+  }
+  return {
+    axis,
+    side: new Vector3(-axis.z, 0, axis.x),
+    yaw: Math.atan2(axis.x, axis.z),
+  };
