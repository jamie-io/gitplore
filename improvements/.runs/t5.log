+    const ground = options.ground.heightAt(point.x, point.z);
+    const post = new Mesh(
+      new CylinderGeometry(0.06, 0.07, 1, 8),
+      new MeshStandardMaterial({ color: 0x5a3d27, roughness: 0.8 }),
