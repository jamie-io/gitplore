+  for (let index = 0; index < JUNGLE_BOARDWALK_PLANK_COUNT; index++) {
+    const point = from.clone().lerp(to, (index + 0.5) / JUNGLE_BOARDWALK_PLANK_COUNT);
+    const plank = new RoundedBoxGeometry(1.45, 0.07, 0.27, 2, 0.02)
+      .rotateY(yaw)
+      .translate(
