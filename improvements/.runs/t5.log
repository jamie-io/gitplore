+    post.position.set(point.x, ground + height / 2, point.z);
+    group.add(post);
+
+    const cap = new Mesh(
+      new SphereGeometry(0.07, 8, 6),
+      new MeshStandardMaterial({ color: 0x5a3d27, emissive: 0x000000, emissiveIntensity: 0 }),
+    );
+    cap.name = `rail-cap-${index}`;
