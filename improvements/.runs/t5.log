+  return typeof value === 'number' && Number.isFinite(value) ? Math.max(0, value) : 0;
+}
+
+function pathFrame(fromPoint: Vector3, toPoint: Vector3): {
+  axis: Vector3;
+  side: Vector3;
+  yaw: number;
